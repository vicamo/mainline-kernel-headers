# syntax=docker/dockerfile:1
#
# Dockerfile.mainline-version — install ONE mainline kernel version's headers.
#
# Build args:
#   KVER             - kernel series, e.g. "6.6" (required)
#   VERSION          - exact version, e.g. "6.6.100" (required)
#   SERIES           - Ubuntu codename, e.g. "noble" (required)
#   ARCHIVE_IMAGE    - archive image (default: ghcr.io/vicamo/linux-headers:KVER-archive)
#   ARCHIVE_PLATFORM - platform of archive image (default: linux/amd64)
#
# For longterm kernels on newer series, build-mainline-version injects
# FROM aliases and --mount flags onto the ADD_SOURCES RUN for extra apt sources.
#

ARG KVER
ARG SERIES=noble
ARG ARCHIVE_IMAGE=ghcr.io/vicamo/linux-headers:${KVER}-archive
ARG ARCHIVE_PLATFORM=linux/amd64

FROM --platform=${ARCHIVE_PLATFORM} ${ARCHIVE_IMAGE} AS archive
FROM ghcr.io/vicamo/linux-headers:${SERIES}-dkms

ARG KVER
ARG VERSION
ARG TARGETARCH

SHELL ["/bin/bash", "-c"]

# Add extra apt sources for longterm kernel support.
# build-mainline-version injects --mount flags onto this RUN when needed.
RUN <<'ADD_SOURCES'
set -euo pipefail
shopt -s nullglob
series_dirs=(/tmp/apt/*/)
[ ${#series_dirs[@]} -eq 0 ] && exit 0
for dir in "${series_dirs[@]}"; do
    s=$(basename "${dir}")
    echo ">>> Adding apt sources for: ${s}"
    if [ -f "${dir}sources.list.d/debian.sources" ]; then
        cp "${dir}sources.list.d/debian.sources" "/etc/apt/sources.list.d/${s}.sources"
    elif [ -f "${dir}sources.list" ]; then
        cp "${dir}sources.list" "/etc/apt/sources.list.d/${s}.list"
    else
        echo "  WARN: no apt sources found in ${dir}" >&2
    fi
done
apt-get update
ADD_SOURCES

RUN --mount=from=archive,source=/${KVER}/${VERSION},target=/tmp/debs <<'INSTALL'
set -euo pipefail

case "${TARGETARCH}" in
    amd64)   arch="amd64"  ;;
    arm64)   arch="arm64"  ;;
    arm)     arch="armhf"  ;;
    386)     arch="i386"   ;;
    ppc64le) arch="ppc64el";;
    s390x)   arch="s390x"  ;;
    riscv64) arch="riscv64";;
    *)       echo "ERROR: unsupported TARGETARCH=${TARGETARCH}"; exit 1 ;;
esac

shopt -s nullglob
all=(/tmp/debs/*_all.deb)
arch_specific=(/tmp/debs/*_${arch}.deb)

if [ ${#all[@]} -eq 0 ] || [ ${#arch_specific[@]} -eq 0 ]; then
    echo "ERROR: no debs for ${arch} in ${VERSION}"
    exit 1
fi

apt-get install -y --no-install-recommends "${all[@]}" "${arch_specific[@]}"
INSTALL
