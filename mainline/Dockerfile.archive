# syntax=docker/dockerfile:1
#
# Dockerfile.archive — archive mainline kernel header .debs.
# Architecture-independent: stores headers for ALL architectures.
#
# The fetching logic lives in scripts/build-archive, which downloads .debs
# into mainline/debs/<KVER>/ before invoking this Dockerfile.
#
# Build args:
#   KVER          - kernel series, e.g. "6.14" (required)
#   ARCHIVE_IMAGE - previous archive image for incremental builds
#                   (default: ghcr.io/vicamo/linux-headers:<KVER>-archive)
#                   Set to "scratch" for cold start.
#

ARG KVER
ARG ARCHIVE_IMAGE=ghcr.io/vicamo/linux-headers:${KVER}-archive

# ===========================================================================
# Accumulate .debs under /<KVER>/<version>/
# ===========================================================================
FROM busybox:musl AS base
FROM ${ARCHIVE_IMAGE}

ARG KVER
COPY --from=base /bin/sh /bin/cp /bin/ls /bin/
RUN --mount=type=bind,source=mainline/debs/${KVER},target=/mnt/debs cp -a /mnt/debs/. /${KVER}/
