#!/usr/bin/env python3
"""
Generate a gap report for Ubuntu generic kernel headers Docker images.

Usage:
    report-gaps [OPTIONS] [SERIES...]

Options:
    --format markdown|json   Output format (default: markdown)
    --json                   Shorthand for --format json
    --from-json              Read JSON data from stdin and render as markdown.
                             Ignores SERIES args; skips all network/docker queries.

When no SERIES are given, discovers active Ubuntu series from ubuntu-releases.

For each Ubuntu series, compares:
  1. Kernel versions available in the Ubuntu archive (via Packages.gz)
  2. Versions installed in the Docker headers image (per-platform annotations)

Icons indicate status:
  ✅ - available and installed
  ⚪ - not available for this arch
  🔺 - available but not installed (needs rebuild)
"""

import gzip
import json
import re
import subprocess
import sys
import urllib.request

IMAGE_PREFIX = "vicamo/mainline-kernel-headers"
OCI_TO_DEB = {
    "linux/386": "i386",
    "linux/amd64": "amd64",
    "linux/amd64/v3": "amd64v3",
    "linux/arm": "armhf",
    "linux/arm/v7": "armhf",
    "linux/arm64": "arm64",
    "linux/ppc": "powerpc",
    "linux/ppc64le": "ppc64el",
    "linux/riscv64": "riscv64",
    "linux/s390x": "s390x",
}
# Pockets to query (excludes -proposed)
POCKETS = ["", "-updates", "-security"]
# Archive mirrors by architecture
ARCHIVE_URL = "http://archive.ubuntu.com/ubuntu"
PORTS_URL = "http://ports.ubuntu.com/ubuntu-ports"
OLD_RELEASES_URL = "http://old-releases.ubuntu.com/ubuntu"
ARCHIVE_ARCHS = {"amd64", "amd64v3", "arm64", "i386"}


def _mirrors_for_arch(arch):
    """Return candidate base URLs for a given architecture (primary + fallback)."""
    primary = ARCHIVE_URL if arch in ARCHIVE_ARCHS else PORTS_URL
    return [primary, OLD_RELEASES_URL]


def _discover_archs(series):
    """Discover supported architectures for a series from the archive.

    Checks which binary-<arch>/ directories exist in the main component.
    Falls back to old-releases.ubuntu.com for EOL series.
    """
    archs = set()
    for base_url in (ARCHIVE_URL, PORTS_URL, OLD_RELEASES_URL):
        url = f"{base_url}/dists/{series}/main/"
        try:
            resp = urllib.request.urlopen(url, timeout=10)
            html = resp.read().decode()
            archs.update(re.findall(r"binary-([a-z0-9]+)", html))
        except Exception:
            pass
    return sorted(archs)


def _fetch_packages(series, arch, flavour="generic"):
    """Fetch linux-headers-*-<flavour> binary package names from the archive.

    Downloads Packages.gz from each pocket for the given series+arch,
    extracts matching package names. This mirrors what `apt-cache search`
    sees inside the Dockerfile.

    Returns a set of kabi strings, e.g. {"6.8.0-31", "6.11.0-8"}.
    """
    pattern = re.compile(
        rf'^Package: linux-headers-(\d+\.\d+\.\d+-\d+)-{re.escape(flavour)}$'
    )
    kabis = set()

    for base_url in _mirrors_for_arch(arch):
        for pocket in POCKETS:
            suite = f"{series}{pocket}"
            url = f"{base_url}/dists/{suite}/main/binary-{arch}/Packages.gz"
            try:
                with urllib.request.urlopen(url, timeout=30) as resp:
                    data = gzip.decompress(resp.read()).decode("utf-8", errors="replace")
                    for line in data.splitlines():
                        m = pattern.match(line)
                        if m:
                            kabis.add(m.group(1))
            except Exception:
                continue
        if kabis:
            break

    return kabis


def discover_versions(series, archs=None, flavour="generic"):
    """Discover available linux-headers packages for a series.

    Returns {kabi: [arch, ...]} by fetching Packages.gz from the Ubuntu
    archive for each arch+pocket. No source package involvement.
    """
    arch_list = archs or _discover_archs(series)
    result = {}  # {kabi: set(arch)}

    for arch in arch_list:
        for kabi in _fetch_packages(series, arch, flavour):
            result.setdefault(kabi, set()).add(arch)

    return {k: sorted(v) for k, v in result.items()}


def get_install_info(series):
    """Get installed versions from the Docker image annotations.

    Returns {arch: {kabi: [flavours]}} or None if image doesn't exist.
    """
    tag = f"{IMAGE_PREFIX}:{series}-generic"
    try:
        r = subprocess.run(
            ["docker", "buildx", "imagetools", "inspect", tag, "--raw"],
            capture_output=True, text=True, timeout=30,
        )
        if r.returncode != 0:
            return None
        data = json.loads(r.stdout)
    except Exception:
        return None

    result = {}
    for m in data.get("manifests", []):
        plat = m.get("platform", {})
        if plat.get("os", "") != "linux":
            continue
        arch = plat.get("architecture", "")
        variant = plat.get("variant", "")
        oci_plat = f"linux/{arch}/{variant}" if variant else f"linux/{arch}"
        deb_arch = OCI_TO_DEB.get(oci_plat) or OCI_TO_DEB.get(f"linux/{arch}")
        if not deb_arch:
            continue
        ann = m.get("annotations", {})
        versions_str = ann.get("dev.mainline-kernel-headers.versions", "")
        if versions_str:
            # Format: {kabi: [flavours]}
            result[deb_arch] = json.loads(versions_str)
        else:
            result[deb_arch] = {}
    return result if result else None


def kabi_sort_key(kabi):
    """Sort key for kernel ABI strings like '6.8.0-31'."""
    parts = re.split(r'[.-]', kabi)
    return tuple(int(p) for p in parts if p.isdigit())


def generate_json(series_list):
    """Generate structured JSON report data.

    Columns are architecture names (e.g. "amd64", "arm64").
    """
    from datetime import datetime, timezone

    results = {}
    for series in series_list:
        print(f"  Querying archive for {series}...", file=sys.stderr)
        available = discover_versions(series)
        install_info = get_install_info(series)

        if not available and not install_info:
            results[series] = {"versions": {}, "columns": []}
            continue

        # Columns = architectures present in archive or image
        columns_set = set()
        for kabi, archs in available.items():
            columns_set.update(archs)
        if install_info:
            columns_set.update(install_info.keys())

        columns = sorted(columns_set)

        # Merge version sets from archive and image
        all_kabis_set = set(available.keys())
        if install_info:
            for arch_data in install_info.values():
                all_kabis_set.update(arch_data.keys())
        all_kabis = sorted(all_kabis_set, key=kabi_sort_key)

        versions_data = {}
        for kabi in all_kabis:
            avail_archs = available.get(kabi, [])
            col_status = {}
            for arch in columns:
                has_archive = arch in avail_archs
                has_install = (install_info is not None and
                              arch in install_info and
                              "generic" in install_info[arch].get(kabi, []))
                if has_install:
                    col_status[arch] = "ok"
                elif has_archive:
                    col_status[arch] = "missing_install"
                elif install_info is None and arch in avail_archs:
                    col_status[arch] = "missing_install"
                else:
                    col_status[arch] = "unavailable"
            versions_data[kabi] = col_status

        results[series] = {
            "versions": versions_data,
            "columns": columns,
        }

    return {
        "updated": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "series": results,
    }


def json_to_markdown(data):
    """Render JSON report data as GitHub-flavored Markdown."""
    lines = []
    lines.append("# Ubuntu Kernel Headers — Gap Report\n")
    lines.append("| Icon | Meaning |")
    lines.append("|------|---------|")
    lines.append("| ✅ | Available and installed |")
    lines.append("| ⚪ | Not available for this arch |")
    lines.append("| 🔺 | Available but not installed (needs rebuild) |")
    lines.append("")

    status_icon = {
        "ok": "✅",
        "unavailable": "⚪",
        "missing_install": "🔺",
    }

    series_data = data.get("series", {})
    for series in sorted(series_data.keys()):
        info = series_data[series]
        lines.append(f"## {series}\n")

        versions = info.get("versions", {})
        columns = info.get("columns", [])

        if not versions:
            lines.append("> No versions found in archive.\n")
            continue

        all_kabis = sorted(versions.keys(), key=kabi_sort_key)

        gap_rows = []
        for kabi in all_kabis:
            col_status = versions[kabi]
            cells = []
            has_gap = False
            for col in columns:
                status = col_status.get(col, "ok")
                cells.append(status_icon.get(status, "?"))
                if status not in ("ok", "unavailable"):
                    has_gap = True
            if has_gap:
                gap_rows.append((kabi, cells))

        if not gap_rows:
            lines.append(f"✅ All {len(all_kabis)} versions fully installed across all architectures.\n")
        else:
            lines.append(f"| Version | {' | '.join(columns)} |")
            lines.append(f"|---------|{'|'.join([':---:'] * len(columns))}|")
            for kabi, cells in gap_rows:
                lines.append(f"| ``{kabi}`` | {' | '.join(cells)} |")
            lines.append("")
            lines.append(f"_{len(gap_rows)}/{len(all_kabis)} versions have gaps_\n")

            complete = [k for k in all_kabis if k not in {r[0] for r in gap_rows}]
            if complete:
                links = ", ".join(f"`{k}`" for k in complete)
                lines.append(f"<details><summary>✅ {len(complete)} complete versions</summary>\n")
                lines.append(f"{links}\n")
                lines.append("</details>\n")

    return "\n".join(lines)


def main():
    import argparse

    parser = argparse.ArgumentParser(
        description="Generate a gap report for Ubuntu generic kernel headers Docker images.",
    )
    parser.add_argument(
        "--format", choices=("markdown", "json"), default="markdown",
        dest="output_format", help="output format (default: markdown)",
    )
    parser.add_argument(
        "--json", action="store_const", const="json", dest="output_format",
        help="shorthand for --format json",
    )
    parser.add_argument(
        "--from-json", action="store_true",
        help="read JSON from stdin and render as markdown",
    )
    parser.add_argument(
        "series", nargs="*", metavar="SERIES",
        help="Ubuntu series to report (required unless --from-json)",
    )
    args = parser.parse_args()

    if args.from_json:
        data = json.load(sys.stdin)
        print(json_to_markdown(data))
    else:
        if not args.series:
            parser.error("SERIES is required when not using --from-json")
        data = generate_json(args.series)
        if args.output_format == "json":
            print(json.dumps(data, indent=2, sort_keys=True))
        else:
            print(json_to_markdown(data))


if __name__ == "__main__":
    main()
