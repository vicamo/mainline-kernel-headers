#!/usr/bin/env bash
#
# Extract an annotation value from an archive image.
# Tries in order:
#   1. Registry via imagetools inspect (works when image is pushed)
#   2. Docker label via docker inspect (works locally, mirrors annotation)
#
# Usage:
#   ./scripts/get-archive-annotation <IMAGE> <KEY>
#
set -euo pipefail

image="${1:-}"
key="${2:-}"

if [ -z "${image}" ] || [ -z "${key}" ]; then
    echo "Usage: $0 <IMAGE> <KEY>" >&2
    exit 1
fi

# Try registry via imagetools inspect
value=$(docker buildx imagetools inspect "${image}" --raw 2>/dev/null \
    | python3 -c "
import json, sys, subprocess

raw = sys.stdin.read().strip()
if not raw:
    sys.exit(0)

data = json.loads(raw)

# If it's an index, dereference to the first non-attestation manifest
if 'manifests' in data:
    for m in data['manifests']:
        ann = m.get('annotations') or {}
        if 'attestation' in ann.get('vnd.docker.reference.type', ''):
            continue
        digest = m['digest']
        r = subprocess.run(
            ['docker', 'buildx', 'imagetools', 'inspect',
             sys.argv[1] + '@' + digest, '--raw'],
            capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            data = json.loads(r.stdout)
        break

annotations = data.get('annotations') or {}
v = annotations.get(sys.argv[2], '')
if v:
    print(v)
" "${image}" "${key}" 2>/dev/null) || true

if [ -n "${value}" ]; then
    echo "${value}"
    exit 0
fi

# Fallback: read from Docker label (mirrors annotation, works locally)
value=$(docker inspect "${image}" --format "{{index .Config.Labels \"${key}\"}}" 2>/dev/null) || true

if [ -n "${value}" ]; then
    echo "${value}"
fi
