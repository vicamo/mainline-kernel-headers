#!/usr/bin/env python3
"""Extract an annotation value from an archive image.

Tries in order:
  1. Registry via `docker buildx imagetools inspect` (works when image is pushed)
  2. Docker label via `docker inspect` (works locally, mirrors annotation)

Usage:
  ./scripts/get-archive-annotation <IMAGE> <KEY>
"""

import json
import subprocess
import sys


def _run(cmd: list[str]) -> str | None:
    r = subprocess.run(cmd, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def _from_registry(image: str, key: str) -> str | None:
    raw = _run(["docker", "buildx", "imagetools", "inspect", image, "--raw"])
    if not raw:
        return None

    data = json.loads(raw)

    # If it's an index, dereference to the first non-attestation manifest
    if "manifests" in data:
        for m in data["manifests"]:
            ann = m.get("annotations") or {}
            if "attestation" in ann.get("vnd.docker.reference.type", ""):
                continue
            digest = m["digest"]
            inner = _run(["docker", "buildx", "imagetools", "inspect",
                          f"{image}@{digest}", "--raw"])
            if inner:
                data = json.loads(inner)
            break

    annotations = data.get("annotations") or {}
    return annotations.get(key) or None


def _from_local(image: str, key: str) -> str | None:
    raw = _run(["docker", "inspect", image,
                "--format", "{{index .Config.Labels \"" + key + "\"}}"])
    return raw or None


def get_archive_annotation(image: str, key: str) -> str | None:
    return _from_registry(image, key) or _from_local(image, key)


def main() -> None:
    import argparse

    parser = argparse.ArgumentParser(
        description="Extract an annotation value from an archive image.")
    parser.add_argument("image", help="Docker image reference")
    parser.add_argument("key", help="Annotation key to extract")
    args = parser.parse_args()

    value = get_archive_annotation(args.image, args.key)
    if value:
        print(value)


if __name__ == "__main__":
    main()
