#!/usr/bin/env python3
"""Query GHCR container image tags with optional prefix filtering.

Usage:
    query-ghcr-tags [OPTIONS] [PACKAGE]

Options:
    --prefix PREFIX   Only return tags starting with PREFIX
    --filter REGEX    Only return tags matching REGEX
    --owner OWNER     GitHub owner (default: vicamo)

PACKAGE defaults to "linux-headers".

Queries the GHCR registry API with anonymous (token-based) auth.
Outputs one tag per line to stdout.
"""

import json
import re
import sys
import urllib.request


def get_ghcr_token(owner: str, package: str) -> str:
    """Get an anonymous pull token for GHCR."""
    url = (
        f"https://ghcr.io/token"
        f"?service=ghcr.io"
        f"&scope=repository:{owner}/{package}:pull"
    )
    with urllib.request.urlopen(url) as resp:
        return json.loads(resp.read())["token"]


def list_tags(owner: str, package: str, token: str) -> list[str]:
    """List all tags from a GHCR package, handling pagination."""
    tags: list[str] = []
    url: str | None = (
        f"https://ghcr.io/v2/{owner}/{package}/tags/list?n=1000"
    )
    while url:
        req = urllib.request.Request(url, headers={
            "Authorization": f"Bearer {token}",
        })
        with urllib.request.urlopen(req) as resp:
            data = json.loads(resp.read())
            tags.extend(data.get("tags", []))
            # OCI pagination via Link header
            link = resp.headers.get("Link", "")
            url = None
            if link:
                m = re.search(r'<([^>]+)>;\s*rel="next"', link)
                if m:
                    url = m.group(1)
    return tags


def main() -> None:
    import argparse

    parser = argparse.ArgumentParser(description="Query GHCR container image tags")
    parser.add_argument("package", nargs="?", default="linux-headers",
                        help="Package name (default: linux-headers)")
    parser.add_argument("--prefix", default="",
                        help="Only return tags starting with this prefix")
    parser.add_argument("--filter", dest="regex", default="",
                        help="Only return tags matching this regex")
    parser.add_argument("--owner", default="vicamo",
                        help="GitHub owner (default: vicamo)")
    args = parser.parse_args()

    try:
        token = get_ghcr_token(args.owner, args.package)
        tags = list_tags(args.owner, args.package, token)
    except urllib.error.HTTPError as e:
        print(f"ERROR: {e.code} {e.reason} fetching tags", file=sys.stderr)
        sys.exit(1)

    for tag in sorted(tags):
        if args.prefix and not tag.startswith(args.prefix):
            continue
        if args.regex and not re.search(args.regex, tag):
            continue
        print(tag)


if __name__ == "__main__":
    main()
