#!/usr/bin/env python3
"""Parallel .deb fetcher for mainline kernel headers.

Discovers versions for the given kernel series from kernel.ubuntu.com/mainline,
validates existing local debs, and downloads missing ones — all in parallel.

The optional ARCHIVE_VERSIONS_JSON (format: {version: {arch: [flavours]}}) tells
which debs are already in the archive image, so they can be skipped.

Prints the number of changed versions to stdout on success.
A version counts as changed if:
  - new debs were downloaded from the remote site, OR
  - local debs already exist on the filesystem (overrides or pre-built).

Exits non-zero on corrupt debs or fatal errors.
"""

import json
import os
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path
from urllib.error import URLError
from urllib.request import Request, urlopen

_script_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, _script_dir)
from lib import MAINLINE_BASE_URL

MAX_DISCOVER_WORKERS = 8
MAX_DOWNLOAD_WORKERS = 16


def fetch(url: str, retries: int = 3) -> str | None:
    """Fetch a URL and return its text content, or None on failure."""
    for attempt in range(retries):
        try:
            with urlopen(Request(url), timeout=30) as r:
                return r.read().decode()
        except Exception:
            if attempt == retries - 1:
                return None


def download(url: str, dest: str, retries: int = 3) -> bool:
    """Download a URL to a local path. Returns True on success."""
    for attempt in range(retries):
        try:
            with urlopen(Request(url), timeout=60) as r:
                data = r.read()
            with open(dest, "wb") as f:
                f.write(data)
            return True
        except Exception:
            if attempt == retries - 1:
                return False


def validate_debs(debs_dir: str) -> None:
    """Validate all local .deb files in parallel. Exits on corruption."""
    debs = list(Path(debs_dir).rglob("*.deb"))
    if not debs:
        return

    print(f">>> Validating {len(debs)} local deb(s) ...", file=sys.stderr)
    corrupt = []

    def check(deb):
        r = subprocess.run(
            ["dpkg-deb", "--info", str(deb)],
            capture_output=True, timeout=30,
        )
        return (deb, r.returncode != 0)

    with ThreadPoolExecutor(max_workers=os.cpu_count() or 4) as pool:
        for deb, is_corrupt in pool.map(lambda d: check(d), debs):
            if is_corrupt:
                corrupt.append(str(deb))

    if corrupt:
        for c in corrupt:
            print(f"ERROR: corrupt deb: {c}", file=sys.stderr)
        sys.exit(1)


def flavour_from_deb(fname: str) -> tuple[str, str] | None:
    """Extract (flavour, arch) from a deb filename, or None.

    linux[-<derived>]-headers-<ver>-<abi>-<flavour>_<ver>_<arch>.deb  (arch != all)
    linux[-<derived>]-headers-<ver>-<abi>_<ver>_all.deb               (arch == all)
    """
    m = re.match(
        r'linux(?:-.+)?-headers-\d+\.\d+\.\d+-\d+(?:-(.+))?_.+_([^_]+)\.deb', fname)
    if m:
        return (m.group(1) or "all", m.group(2))
    return None


def discover_version(
    base_url: str,
    kver_dir: str,
    vnum: str,
    out_dir: str,
    archive_flavours: dict[str, list[str]],
) -> tuple[str, bool, str | None]:
    """Discover and download missing debs for one version.

    archive_flavours: {arch: [flavours]} for this version from the archive
                      annotation, or {} if not in archive.

    Returns (vnum, is_changed, error).
    """
    ver_url = f"{base_url}/{kver_dir}/"
    os.makedirs(out_dir, exist_ok=True)

    # Check for local debs (pre-downloaded or manual builds)
    local_debs = list(Path(out_dir).glob("*.deb"))

    # Fetch version index from website
    top = fetch(ver_url)
    if not top:
        return (vnum, False, f"cannot fetch {ver_url}")

    # Find arch subdirs
    archdirs = set(re.findall(r'href="([a-z0-9]+)/"', top)) - {
        "BUILT", "CHANGES", "HEADER", "FOOTER"
    }

    # Collect all deb URLs to download
    downloads: list[tuple[str, str]] = []

    def scan_page(page_url: str, page_content: str) -> list[tuple[str, str]]:
        """Scan a page for header debs and return download items."""
        items = []
        for deb in set(re.findall(
                r'href="(linux(?:-.+)?-headers-[^"]+\.deb)"', page_content)):
            local = os.path.join(out_dir, deb)
            if os.path.isfile(local):
                continue
            info = flavour_from_deb(deb)
            if not info:
                continue
            flavour, arch = info
            archived = set(archive_flavours.get(arch, []))
            if flavour in archived:
                continue
            items.append((f"{page_url}{deb}", local))
        return items

    if archdirs:
        # Newer layout: debs are inside arch subdirectories
        def scan_arch(archdir):
            arch_url = f"{ver_url}{archdir}/"
            page = fetch(arch_url)
            if not page:
                return []
            return scan_page(arch_url, page)

        with ThreadPoolExecutor(max_workers=len(archdirs)) as pool:
            for items in pool.map(scan_arch, archdirs):
                downloads.extend(items)
    else:
        # Flat layout (older kernels): debs are listed on the version page
        downloads.extend(scan_page(ver_url, top))

    # Deduplicate (same _all.deb may appear in multiple archdirs)
    seen: set[str] = set()
    unique_downloads = []
    for url, local in downloads:
        if local not in seen:
            seen.add(local)
            unique_downloads.append((url, local))

    if not unique_downloads:
        return (vnum, bool(local_debs), None)

    # Download missing debs in parallel
    failed = []
    with ThreadPoolExecutor(max_workers=MAX_DOWNLOAD_WORKERS) as pool:
        futures = {
            pool.submit(download, url, local): (url, local)
            for url, local in unique_downloads
        }
        for f in as_completed(futures):
            url, local = futures[f]
            if not f.result():
                failed.append(url)
            else:
                print(f"  GET {os.path.basename(local)}", file=sys.stderr)

    if failed:
        return (vnum, True, f"failed downloads: {failed}")

    return (vnum, True, None)


def fetch_debs(
    kver: str,
    base_url: str,
    debs_dir: str,
    archive_versions: dict[str, dict[str, list[str]]] | None = None,
) -> int:
    """Fetch all debs for a kernel series. Returns the number of changed versions."""
    archive = archive_versions or {}

    # Validate all local debs upfront
    validate_debs(debs_dir)

    # Discover versions from mainline index
    print(f">>> Discovering versions for series {kver} ...", file=sys.stderr)
    index = fetch(f"{base_url}/")
    if not index:
        print(f"ERROR: cannot fetch {base_url}/", file=sys.stderr)
        sys.exit(1)

    pattern = re.compile(rf'href="v({re.escape(kver)}(?:\.\d+)?)/?"')
    versions = sorted(
        set(pattern.findall(index)),
        key=lambda v: [int(p) for p in v.split(".")],
    )

    if not versions:
        print(f"ERROR: no versions matching {kver} at {base_url}/", file=sys.stderr)
        sys.exit(1)

    print(f"Found {len(versions)} version(s): {versions[0]} .. {versions[-1]}",
          file=sys.stderr)

    # Process all versions in parallel
    new_versions = 0
    errors = []

    with ThreadPoolExecutor(max_workers=MAX_DISCOVER_WORKERS) as pool:
        futures = {}
        for vnum in versions:
            kver_dir = f"v{vnum}"
            out_dir = os.path.join(debs_dir, vnum)
            archive_flavours = archive.get(vnum, {})
            futures[pool.submit(
                discover_version, base_url, kver_dir, vnum,
                out_dir, archive_flavours,
            )] = vnum

        for f in as_completed(futures):
            vnum, is_changed, error = f.result()
            if error:
                errors.append(f"{vnum}: {error}")
            if is_changed:
                new_versions += 1
                print(f">>> v{vnum}: changed.", file=sys.stderr)
            else:
                print(f">>> v{vnum}: up to date.", file=sys.stderr)

    if errors:
        for e in errors:
            print(f"WARNING: {e}", file=sys.stderr)

    return new_versions


def main() -> None:
    import argparse

    parser = argparse.ArgumentParser(
        description="Parallel .deb fetcher for mainline kernel headers.")
    parser.add_argument("kver", help="Kernel series (e.g. '6.14')")
    parser.add_argument("base_url", nargs="?", default=MAINLINE_BASE_URL,
                        help="Base URL for mainline builds (default: %(default)s)")
    parser.add_argument("debs_dir", nargs="?", default=os.getcwd(),
                        help="Local directory to store debs (default: $PWD)")
    parser.add_argument("archive_versions_json", nargs="?", default="",
                        help="JSON: {version: {arch: [flavours]}} already in archive")
    args = parser.parse_args()

    archive = {}
    if args.archive_versions_json:
        try:
            archive = json.loads(args.archive_versions_json)
        except (json.JSONDecodeError, ValueError):
            pass

    new_versions = fetch_debs(args.kver, args.base_url.rstrip("/"),
                              args.debs_dir, archive)
    print(new_versions)


if __name__ == "__main__":
    main()
