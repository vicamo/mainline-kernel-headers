#!/usr/bin/env bash
#
# Build archive and install images for a given kernel series.
#
# Usage:
#   ./scripts/build-version <KVER> [--push] [--image PREFIX] [--platforms PLATFORMS]
#
# Examples:
#   ./scripts/build-version 7.0
#   ./scripts/build-version 7.0 --push
#   ./scripts/build-version 7.0 --push --image myrepo/kernel-headers
#   ./scripts/build-version 7.0 --push --platforms linux/amd64,linux/arm64
#
set -euo pipefail

# Require containerd-snapshotter for multi-platform --load and local annotations.
if ! docker info -f '{{.DriverStatus}}' 2>/dev/null | grep -q 'io.containerd.snapshotter'; then
    echo "ERROR: containerd-snapshotter not enabled in Docker daemon." >&2
    echo "Multi-platform --load requires containerd image store." >&2
    exit 1
fi

script_dir="$(cd "$(dirname "$0")" && pwd)"
repo_dir="$(dirname "${script_dir}")"

push=false
kver=""
image_prefix="vicamo/mainline-kernel-headers"
install_platforms="linux/amd64,linux/arm64,linux/arm/v7,linux/ppc64le,linux/s390x"
skip_archive=false

while [ $# -gt 0 ]; do
    case "$1" in
        --push)          push=true; shift ;;
        --image)         image_prefix="$2"; shift 2 ;;
        --platforms)     install_platforms="$2"; shift 2 ;;
        --skip-archive)  skip_archive=true; shift ;;
        -*)              echo "Unknown flag: $1" >&2; exit 1 ;;
        *)               kver="$1"; shift ;;
    esac
done

if [ -z "${kver}" ]; then
    echo "Usage: $0 <KVER> [--push] [--image PREFIX] [--platforms PLATFORMS]" >&2
    exit 1
fi

archive_tag="${image_prefix}:${kver}-archive"
install_tag="${image_prefix}:${kver}"

# ---------------------------------------------------------------------------
# Step 1: Build the archive image (single-platform, incremental by default)
# ---------------------------------------------------------------------------
if [ "${skip_archive}" = true ]; then
    echo "=== Skipping archive build (--skip-archive) ==="
    if ! docker buildx imagetools inspect "${archive_tag}" >/dev/null 2>&1; then
        echo "ERROR: --skip-archive but ${archive_tag} not found in registry" >&2
        exit 1
    fi
else
    archive_flags=(--image "${image_prefix}")
    if [ "${push}" = true ]; then
        archive_flags+=(--push)
    fi
    "${script_dir}/build-archive" "${kver}" "${archive_flags[@]}"
fi

# ---------------------------------------------------------------------------
# Step 2: Build the install image (multi-platform)
# ---------------------------------------------------------------------------
echo ""
echo "=== Building install: ${install_tag} ==="

# Check if the install image is already up to date with the archive.
# Extract the version list from the archive manifest annotation.
archive_versions=$(
    v=$("${script_dir}/get-archive-annotation" "${archive_tag}" "dev.mainline-kernel-headers.versions") || true
    if [ -n "${v}" ]; then
        echo "${v}" | python3 -c "import json,sys; print(','.join(sorted(json.loads(sys.stdin.read()).keys())))"
    fi
) || true

if [ -n "${archive_versions}" ] && \
   docker buildx imagetools inspect "${install_tag}" >/dev/null 2>&1; then
    install_versions=$(docker buildx imagetools inspect "${install_tag}" --raw 2>/dev/null \
        | python3 -c "
import json, sys
data = json.load(sys.stdin)
annotations = data.get('annotations') or {}
v = annotations.get('dev.mainline-kernel-headers.archive-versions', '')
if v:
    print(v)
" 2>/dev/null) || true

    if [ -n "${install_versions}" ] && [ "${archive_versions}" = "${install_versions}" ]; then
        echo "  Install image already matches archive versions"
        echo "  Versions: ${install_versions}"
        echo ""
        echo "--- Install image inspection ---"
        docker buildx imagetools inspect "${install_tag}" --raw 2>/dev/null || true
        echo ""
        echo "=== Done: ${kver} (up to date) ==="
        exit 0
    fi
fi

# Determine the appropriate Ubuntu base image for cold-start builds.
# Ubuntu release kernel versions (codename -> release kernel):
#   Jammy    (22.04) -> 5.15
#   Kinetic  (22.10) -> 5.19
#   Lunar    (23.04) -> 6.2
#   Mantic   (23.10) -> 6.5
#   Noble    (24.04) -> 6.8
#   Oracular (24.10) -> 6.11
#   Plucky   (25.04) -> 6.14
#   Questing (25.10) -> 6.17
#   Resolute (26.04) -> 7.0
#
# We pick the newest Ubuntu release whose kernel version <= KVER.
# Format: "major_minor codename" sorted descending.
ubuntu_base_for_kver() {
    local kver="$1"
    local major minor ver_num
    major=$(echo "${kver}" | cut -d. -f1)
    minor=$(echo "${kver}" | cut -d. -f2)
    ver_num=$(( major * 100 + minor ))

    # Descending order: newest first
    local -a releases=(
        "700 resolute"
        "617 questing"
        "614 plucky"
        "611 oracular"
        "608 noble"
        "605 mantic"
        "602 lunar"
        "519 kinetic"
        "515 jammy"
    )

    for entry in "${releases[@]}"; do
        local rel_ver="${entry%% *}"
        local rel_name="${entry##* }"
        if [ ${ver_num} -ge ${rel_ver} ]; then
            echo "ubuntu:${rel_name}"
            return
        fi
    done
    # Fallback for very old kernels
    echo "ubuntu:jammy"
}

install_args=(
    --build-arg "KVER=${kver}"
    --build-arg "ARCHIVE_IMAGE=${archive_tag}"
)

if docker buildx imagetools inspect "${install_tag}" >/dev/null 2>&1; then
    echo "  (incremental: previous install image found)"
    install_args+=(--build-arg "BASE_IMAGE=${install_tag}")
else
    base_image=$(ubuntu_base_for_kver "${kver}")
    echo "  (cold start: using ${base_image} as base)"
    install_args+=(--build-arg "BASE_IMAGE=${base_image}")
fi

# Step 2a: Build all platforms and load locally (tmp tag)
tmp_tag="${install_tag}-tmp"
echo ""
echo "--- Building multi-platform install (tmp) ---"
docker rmi "${tmp_tag}" >/dev/null 2>&1 || true
docker buildx build \
    --platform "${install_platforms}" \
    "${install_args[@]}" \
    -t "${tmp_tag}" \
    --load \
    "${repo_dir}"

# Step 2b: Extract per-platform version info via docker create --platform
echo ""
echo "--- Extracting per-platform version info ---"

annotation_args=()
annotation_args+=(--annotation "index:org.opencontainers.image.description=Mainline kernel headers for series ${kver}")
annotation_args+=(--annotation "index:dev.mainline-kernel-headers.archive-versions=${archive_versions}")

IFS=',' read -ra plats <<< "${install_platforms}"
for plat in "${plats[@]}"; do
    echo "  Extracting versions for ${plat} ..."
    plat_versions=$(
        cid=$(docker create --platform "${plat}" "${tmp_tag}" sh 2>/dev/null) || true
        if [ -n "${cid}" ]; then
            docker cp "${cid}:/kernel-versions.txt" - 2>/dev/null | tar -xO 2>/dev/null \
                | paste -sd,
            docker rm "${cid}" >/dev/null 2>&1
        fi
    ) || true

    if [ -n "${plat_versions}" ]; then
        echo "    Versions: ${plat_versions}"
        annotation_args+=(--annotation "manifest-descriptor[${plat}]:dev.mainline-kernel-headers.versions=${plat_versions}")
    fi
done

# Step 2c: Rebuild with annotations + load (+ push if requested)
echo ""
echo "--- Building with annotations ---"
push_flags=()
if [ "${push}" = true ]; then
    push_flags+=(--push)
fi

docker rmi "${install_tag}" >/dev/null 2>&1 || true
docker buildx build \
    --platform "${install_platforms}" \
    "${install_args[@]}" \
    "${annotation_args[@]}" \
    -t "${install_tag}" \
    --load \
    "${push_flags[@]}" \
    "${repo_dir}"

# Clean up tmp tag
docker rmi "${tmp_tag}" >/dev/null 2>&1 || true

echo ""
echo "--- Install image inspection ---"
docker buildx imagetools inspect "${install_tag}" --raw 2>/dev/null || true

echo ""
echo "=== Done: ${kver} ==="
echo "  Archive: ${archive_tag}"
echo "  Install: ${install_tag}"
