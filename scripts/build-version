#!/usr/bin/env bash
#
# Build the headers image for a given kernel series.
# Requires the archive image to already exist.
#
# Usage:
#   ./scripts/build-version <KVER> [--push] [--image PREFIX] [--platforms PLATFORMS]
#
# Examples:
#   ./scripts/build-version 7.0
#   ./scripts/build-version 7.0 --push
#   ./scripts/build-version 7.0 --push --image myrepo/kernel-headers
#   ./scripts/build-version 7.0 --push --platforms linux/amd64,linux/arm64
#
set -euo pipefail

# Require containerd-snapshotter for multi-platform --load and local annotations.
if ! docker info -f '{{.DriverStatus}}' 2>/dev/null | grep -q 'io.containerd.snapshotter'; then
    echo "ERROR: containerd-snapshotter not enabled in Docker daemon." >&2
    echo "Multi-platform --load requires containerd image store." >&2
    exit 1
fi

script_dir="$(cd "$(dirname "$0")" && pwd)"
repo_dir="$(dirname "${script_dir}")"

push=
force=
clean=
kver=""
image_prefix="vicamo/mainline-kernel-headers"
headers_platforms="linux/amd64,linux/arm64,linux/arm/v7,linux/ppc64le,linux/s390x"

while [ $# -gt 0 ]; do
    case "$1" in
        --push)          push=--push; shift ;;
        --force)         force=1; shift ;;
        --clean)         clean=1; shift ;;
        --image)         image_prefix="$2"; shift 2 ;;
        --platforms)     headers_platforms="$2"; shift 2 ;;
        -*)              echo "Unknown flag: $1" >&2; exit 1 ;;
        *)               kver="$1"; shift ;;
    esac
done

if [ -z "${kver}" ]; then
    echo "Usage: $0 <KVER> [--push] [--image PREFIX] [--platforms PLATFORMS]" >&2
    exit 1
fi

archive_tag="${image_prefix}:${kver}-archive"
headers_tag="${image_prefix}:${kver}"

# Verify archive image exists
if ! "${script_dir}/get-archive-annotation" "${archive_tag}" "dev.mainline-kernel-headers.versions" >/dev/null 2>&1; then
    echo "ERROR: archive image ${archive_tag} not found. Run build-archive first." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Build the headers image (multi-platform)
# ---------------------------------------------------------------------------
echo ""
echo "=== Building headers: ${headers_tag} ==="

# Check if the install image is already up to date with the archive.
# Extract the version list from the archive manifest annotation.
archive_versions=$(
    v=$("${script_dir}/get-archive-annotation" "${archive_tag}" "dev.mainline-kernel-headers.versions") || true
    if [ -n "${v}" ]; then
        echo "${v}" | python3 -c "import json,sys; print(','.join(sorted(json.loads(sys.stdin.read()).keys())))"
    fi
) || true

if [ -n "${archive_versions}" ] && \
   docker buildx imagetools inspect "${headers_tag}" >/dev/null 2>&1; then
    headers_versions=$(docker buildx imagetools inspect "${headers_tag}" --raw 2>/dev/null \
        | python3 -c "
import json, sys
data = json.load(sys.stdin)
annotations = data.get('annotations') or {}
v = annotations.get('dev.mainline-kernel-headers.archive-versions', '')
if v:
    print(v)
" 2>/dev/null) || true

    if [ -z "${force}" ] && [ -n "${headers_versions}" ] && [ "${archive_versions}" = "${headers_versions}" ]; then
        echo "  Headers image already matches archive versions"
        echo "  Versions: ${headers_versions}"
        echo ""
        echo "--- Install image inspection ---"
        docker buildx imagetools inspect "${headers_tag}" --raw 2>/dev/null || true
        echo ""
        echo "=== Done: ${kver} (up to date) ==="
        exit 0
    fi
fi

# Determine the appropriate Ubuntu base image for cold-start builds.
# Ubuntu release kernel versions (codename -> release kernel):
#   Jammy    (22.04) -> 5.15
#   Kinetic  (22.10) -> 5.19
#   Lunar    (23.04) -> 6.2
#   Mantic   (23.10) -> 6.5
#   Noble    (24.04) -> 6.8
#   Oracular (24.10) -> 6.11
#   Plucky   (25.04) -> 6.14
#   Questing (25.10) -> 6.17
#   Resolute (26.04) -> 7.0
#
# We pick the newest Ubuntu release whose kernel version <= KVER.
# Format: "major_minor codename" sorted descending.
ubuntu_base_for_kver() {
    local kver="$1"
    local major minor ver_num
    major=$(echo "${kver}" | cut -d. -f1)
    minor=$(echo "${kver}" | cut -d. -f2)
    ver_num=$(( major * 100 + minor ))

    # Descending order: newest first
    local -a releases=(
        "700 resolute"
        "617 questing"
        "614 plucky"
        "611 oracular"
        "608 noble"
        "605 mantic"
        "602 lunar"
        "519 kinetic"
        "515 jammy"
        "513 impish"
        "511 hirsuit"
        "508 groovy"
        "504 focal"
        "503 eoan"
        "500 disco"
        "418 cosmic"
        "415 bionic"
        "413 artful"
        "410 zesty"
        "408 yakkety"
        "404 xenial"
        "402 wily"
        "319 vivid"
        "316 utopic"
        "313 trusty"
        "311 saucy"
        "308 raring"
        "305 quantal"
        "302 precise"
        "300 oneiric"
    )

    for entry in "${releases[@]}"; do
        local rel_ver="${entry%% *}"
        local rel_name="${entry##* }"
        if [ ${ver_num} -ge ${rel_ver} ]; then
            echo "ubuntu:${rel_name}"
            return
        fi
    done
    # Fallback for very old kernels
    echo "ubuntu:trusty"
}

headers_args=(
    --build-arg "KVER=${kver}"
    --build-arg "ARCHIVE_IMAGE=${archive_tag}"
)

if [ -z "${clean}" ] && docker buildx imagetools inspect "${headers_tag}" >/dev/null 2>&1; then
    echo "  (incremental: previous headers image found)"
    headers_args+=(--build-arg "BASE_IMAGE=${headers_tag}")
else
    base_image=$(ubuntu_base_for_kver "${kver}")
    echo "  (cold start: using ${base_image} as base)"
    headers_args+=(--build-arg "BASE_IMAGE=${base_image}")
fi

# Build all platforms and load locally (tmp tag)
tmp_tag="${headers_tag}-tmp"
echo ""
echo "--- Building multi-platform install (tmp) ---"
docker rmi "${tmp_tag}" >/dev/null 2>&1 || true
docker buildx build \
    --platform "${headers_platforms}" \
    "${headers_args[@]}" \
    -t "${tmp_tag}" \
    --load \
    "${repo_dir}"

# Extract per-platform version info
echo ""
echo "--- Extracting per-platform version info ---"

annotation_args=()
annotation_args+=(--annotation "index:org.opencontainers.image.description=Mainline kernel headers for series ${kver}")
annotation_args+=(--annotation "index:dev.mainline-kernel-headers.archive-versions=${archive_versions}")

IFS=',' read -ra plats <<< "${headers_platforms}"
for plat in "${plats[@]}"; do
    echo "  Extracting versions for ${plat} ..."
    plat_versions=$(
        docker save --platform "${plat}" "${tmp_tag}" 2>/dev/null \
            | python3 -c "
import tarfile, json, io, sys, re

tar = tarfile.open(fileobj=sys.stdin.buffer, mode='r|')

# First pass: read all members into memory
content = {}
for member in tar:
    if member.isfile():
        data = tar.extractfile(member).read()
        content[member.name] = data

# Determine format: OCI (index.json) or Docker (manifest.json)
if 'index.json' in content:
    # OCI layout
    idx = json.loads(content['index.json'])
    manifest_desc = idx['manifests'][0]
    manifest_blob = content['blobs/' + manifest_desc['digest'].replace(':', '/')]
    manifest = json.loads(manifest_blob)
    layers = [content['blobs/' + l['digest'].replace(':', '/')] for l in manifest['layers']]
else:
    # Docker format
    mf = json.loads(content['manifest.json'])
    layers = [content[l] for l in mf[0]['Layers']]

# Extract var/lib/dpkg/status from the topmost layer that has it
dpkg_status = None
for layer_data in layers:
    try:
        lt = tarfile.open(fileobj=io.BytesIO(layer_data), mode='r:*')
        for m in lt:
            if m.name in ('var/lib/dpkg/status', './var/lib/dpkg/status'):
                dpkg_status = lt.extractfile(m).read().decode()
                break
        lt.close()
    except Exception:
        pass

if not dpkg_status:
    sys.exit(0)

# {version: set(flavours)}
from collections import defaultdict
versions = defaultdict(set)
for block in dpkg_status.split('\n\n'):
    if 'Package: linux-headers-' not in block:
        continue
    pkg = arch = ''
    for line in block.splitlines():
        if line.startswith('Package: '):
            pkg = line[9:]
        elif line.startswith('Architecture: '):
            arch = line[14:]
    if pkg.startswith('linux-headers-') and arch:
        # linux[-<derived>]-headers-<ver>-<abi>[-<flavour>]
        m = re.match(r'linux(?:-.+)?-headers-(\d+\.\d+(?:\.\d+)?)-\d+(?:-(.+))?', pkg)
        if m:
            ver = m.group(1)
            # Normalize: strip trailing .0 (e.g. 7.0.0 -> 7.0)
            if ver.endswith('.0') and ver.count('.') == 2:
                ver = ver[:-2]
            flavour = m.group(2) or 'all'
            versions[ver].add(flavour)
if versions:
    result = {v: sorted(f) for v, f in sorted(versions.items())}
    print(json.dumps(result, separators=(',', ':')))
" 2>/dev/null
    ) || true

    if [ -n "${plat_versions}" ]; then
        echo "    Versions: ${plat_versions}"
        annotation_args+=(--annotation "manifest-descriptor[${plat}]:dev.mainline-kernel-headers.versions=${plat_versions}")
    fi
done

# Rebuild with annotations
echo ""
echo "--- ${push:+Pushing}${push:-Loading} with annotations ---"

docker rmi "${headers_tag}" >/dev/null 2>&1 || true
docker buildx build \
    --platform "${headers_platforms}" \
    "${headers_args[@]}" \
    "${annotation_args[@]}" \
    -t "${headers_tag}" \
    ${push:---load} \
    "${repo_dir}"

# Clean up tmp tag
docker rmi "${tmp_tag}" >/dev/null 2>&1 || true

echo ""
echo "--- Install image inspection ---"
IFS=',' read -ra plats <<< "${headers_platforms}"
for plat in "${plats[@]}"; do
    if [ -n "${push}" ]; then
        val=$(docker buildx imagetools inspect "${headers_tag}" --raw 2>/dev/null \
            | python3 -c "
import json, sys
data = json.load(sys.stdin)
for m in data.get('manifests', []):
    p = m.get('platform', {})
    plat_str = p.get('os','') + '/' + p.get('architecture','')
    if p.get('variant'):
        plat_str += '/' + p['variant']
    if plat_str == '${plat}':
        print(m.get('annotations', {}).get('dev.mainline-kernel-headers.versions', ''))
        break
" 2>/dev/null) || true
    else
        val=$(docker image inspect --platform "${plat}" "${headers_tag}" \
            --format '{{index .Descriptor.Annotations "dev.mainline-kernel-headers.versions"}}' 2>/dev/null) || true
    fi
    echo "  ${plat}: dev.mainline-kernel-headers.versions=${val:-<none>}"
done

echo ""
echo "=== Done: ${kver} ==="
echo "  Archive: ${archive_tag}"
echo "  Headers: ${headers_tag}"
