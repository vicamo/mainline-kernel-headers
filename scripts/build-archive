#!/usr/bin/env bash
#
# Build the archive image for a given kernel series.
#
# Usage:
#   ./scripts/build-archive <KVER> [--push] [--image PREFIX]
#
# Examples:
#   ./scripts/build-archive 7.0
#   ./scripts/build-archive 7.0 --push
#   ./scripts/build-archive 7.0 --push --image myrepo/kernel-headers
#
set -euo pipefail

# Require containerd-snapshotter for OCI annotation support in local store
if ! docker info -f '{{.DriverStatus}}' 2>/dev/null | grep -q 'io.containerd'; then
    echo "ERROR: containerd-snapshotter is not enabled in Docker daemon." >&2
    echo "Enable it with: {\"features\":{\"containerd-snapshotter\":true}} in daemon.json" >&2
    exit 1
fi

script_dir="$(cd "$(dirname "$0")" && pwd)"
repo_dir="$(dirname "${script_dir}")"

push=
kver=""
image_prefix="vicamo/mainline-kernel-headers"

while [ $# -gt 0 ]; do
    case "$1" in
        --push)   push=--push; shift ;;
        --image)  image_prefix="$2"; shift 2 ;;
        -*)       echo "Unknown flag: $1" >&2; exit 1 ;;
        *)        kver="$1"; shift ;;
    esac
done

if [ -z "${kver}" ]; then
    echo "Usage: $0 <KVER> [--push] [--image PREFIX]" >&2
    exit 1
fi

archive_tag="${image_prefix}:${kver}-archive"

# ---------------------------------------------------------------------------
# Step 1: Fetch .deb packages into debs/<KVER>/
# ---------------------------------------------------------------------------
echo "=== Fetching kernel headers for series ${kver} ==="

base_url="https://kernel.ubuntu.com/mainline"
debs_dir="${repo_dir}/debs/${kver}"
mkdir -p "${debs_dir}"

# Retrieve existing archive annotation for early-exit check.
archive_versions_json=$("${script_dir}/get-archive-annotation" "${archive_tag}" "dev.mainline-kernel-headers.versions" 2>/dev/null) || true

# Parallel fetch of .deb packages using Python
new_versions=$(python3 -u "${script_dir}/fetch-debs" "${kver}" "${base_url}" "${debs_dir}" "${archive_versions_json}")

if [ "${new_versions}" -eq 0 ]; then
    echo "=== No new versions found, nothing to do. ==="
    [ -n "${archive_versions_json}" ] && echo "${archive_versions_json}"
    exit 0
fi

echo "=== Fetching complete (${new_versions} new version(s)) ==="

# ---------------------------------------------------------------------------
# Step 2: Build the archive image
# ---------------------------------------------------------------------------
echo ""
echo "=== Building archive: ${archive_tag} ==="

archive_args=(
    --build-arg "KVER=${kver}"
)

if docker buildx imagetools inspect "${archive_tag}" >/dev/null 2>&1; then
    echo "  (incremental: previous archive found)"
    archive_args+=(--build-arg "ARCHIVE_IMAGE=${archive_tag}")
else
    echo "  (cold start: no previous archive)"
    archive_args+=(--build-arg "ARCHIVE_IMAGE=scratch")
fi

# Build and load into local docker daemon (temporary tag for extraction)
docker rmi "${archive_tag}-tmp" >/dev/null 2>&1 || true
docker buildx build \
    -f "${repo_dir}/Dockerfile.archive" \
    "${archive_args[@]}" \
    -t "${archive_tag}-tmp" \
    --load \
    "${repo_dir}"

# Extract version info by scanning .deb filenames in the archive
echo ""
echo "--- Extracting version info from archive ---"
versions_json=$(docker run --rm "${archive_tag}-tmp" /bin/ls -R "/${kver}/" 2>/dev/null \
    | python3 -c "
import sys, re, json
from collections import defaultdict

# {version: {arch: set(flavours)}}
versions = defaultdict(lambda: defaultdict(set))
current_ver = ''
for line in sys.stdin.read().strip().splitlines():
    if line.endswith(':'):
        m = re.search(r'/(\d+\.\d+(?:\.\d+)?):$', line)
        current_ver = m.group(1) if m else ''
        continue
    if not current_ver or not line.endswith('.deb'):
        continue
    fname = line.strip()
    # linux[-<derived>]-headers-<ver>-<abi>_<ver>_all.deb (no flavour for arch=all)
    # linux[-<derived>]-headers-<ver>-<abi>-<flavour>_<ver>_<arch>.deb
    m = re.match(r'linux(?:-.+)?-headers-\d+\.\d+\.\d+-\d+(?:-(.+))?_.+_([^_]+)\.deb', fname)
    if not m:
        continue
    flavour, arch = m.group(1) or 'all', m.group(2)
    versions[current_ver][arch].add(flavour)

if versions:
    result = {v: {a: sorted(f) for a, f in sorted(archs.items())}
              for v, archs in sorted(versions.items())}
    print(json.dumps(result, separators=(',', ':')))
") || true

annotation_args=()
if [ -n "${versions_json}" ]; then
    echo "  Versions: ${versions_json}"
    annotation_args+=(--annotation "manifest:org.opencontainers.image.description=Mainline kernel header .deb archive for series ${kver}")
    annotation_args+=(--annotation "manifest:dev.mainline-kernel-headers.versions=${versions_json}")
fi

# Rebuild with annotations (cached, just updates metadata) and push if requested
echo ""
echo "--- ${push:+Pushing}${push:-Loading} with annotations ---"
docker rmi "${archive_tag}" >/dev/null 2>&1 || true
docker buildx build \
    -f "${repo_dir}/Dockerfile.archive" \
    "${archive_args[@]}" \
    "${annotation_args[@]}" \
    --build-arg "VERSIONS_JSON=${versions_json}" \
    -t "${archive_tag}" \
    ${push:---load} \
    "${repo_dir}"

docker rmi "${archive_tag}-tmp" >/dev/null 2>&1

echo ""
"${script_dir}/get-archive-annotation" "${archive_tag}" "dev.mainline-kernel-headers.versions" || true

echo ""
echo "=== Done: ${archive_tag} ==="
