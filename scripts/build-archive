#!/usr/bin/env bash
#
# Build the archive image for a given kernel series.
#
# Usage:
#   ./scripts/build-archive <KVER> [--push] [--image PREFIX]
#
# Examples:
#   ./scripts/build-archive 7.0
#   ./scripts/build-archive 7.0 --push
#   ./scripts/build-archive 7.0 --push --image myrepo/kernel-headers
#
set -euo pipefail

# Require containerd-snapshotter for OCI annotation support in local store
if ! docker info -f '{{.DriverStatus}}' 2>/dev/null | grep -q 'io.containerd'; then
    echo "ERROR: containerd-snapshotter is not enabled in Docker daemon." >&2
    echo "Enable it with: {\"features\":{\"containerd-snapshotter\":true}} in daemon.json" >&2
    exit 1
fi

script_dir="$(cd "$(dirname "$0")" && pwd)"
repo_dir="$(dirname "${script_dir}")"

push=false
kver=""
image_prefix="vicamo/mainline-kernel-headers"

while [ $# -gt 0 ]; do
    case "$1" in
        --push)   push=true; shift ;;
        --image)  image_prefix="$2"; shift 2 ;;
        -*)       echo "Unknown flag: $1" >&2; exit 1 ;;
        *)        kver="$1"; shift ;;
    esac
done

if [ -z "${kver}" ]; then
    echo "Usage: $0 <KVER> [--push] [--image PREFIX]" >&2
    exit 1
fi

archive_tag="${image_prefix}:${kver}-archive"

# ---------------------------------------------------------------------------
# Step 1: Fetch .deb packages into debs/<KVER>/
# ---------------------------------------------------------------------------
echo "=== Fetching kernel headers for series ${kver} ==="

base_url="https://kernel.ubuntu.com/mainline"
debs_dir="${repo_dir}/debs/${kver}"
mkdir -p "${debs_dir}"

# Determine which versions already exist in the archive image (if any).
existing_versions=""
archive_versions_json=$("${script_dir}/get-archive-annotation" "${archive_tag}" "dev.mainline-kernel-headers.versions" 2>/dev/null) || true
if [ -n "${archive_versions_json}" ]; then
    existing_versions=$(echo "${archive_versions_json}" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for k in sorted(data.keys()):
    print(k)
")
fi

echo ">>> Discovering versions for series ${kver} ..."
index=$(curl -fsSL --retry 3 --retry-delay 5 "${base_url}/")

versions=$(echo "${index}" \
    | grep -oP "href=\"v\K${kver//./\\.}(\.\d+)?(?=/\")" \
    | sort -V | uniq)

if [ -z "${versions}" ]; then
    echo "ERROR: no versions matching ${kver} at ${base_url}/"
    exit 1
fi
printf 'Found: v%s\n' ${versions}

new_versions=0
for vnum in ${versions}; do
    ver_dir="v${vnum}"
    out_dir="${debs_dir}/${vnum}"

    # Skip if already in the archive image
    if echo "${existing_versions}" | grep -qxF "${vnum}"; then
        echo ">>> ${ver_dir}: already in archive, skipping."
        continue
    fi

    echo ">>> ${ver_dir}: checking headers (all architectures) ..."
    ver_url="${base_url}/${ver_dir}"
    mkdir -p "${out_dir}"

    # Validate all existing local debs first
    if [ -d "${out_dir}" ]; then
        for local_deb in "${out_dir}"/*.deb; do
            [ -f "${local_deb}" ] || continue
            if ! dpkg-deb --info "${local_deb}" >/dev/null 2>&1; then
                echo "ERROR: corrupt deb: ${local_deb}" >&2
                echo "Please inspect and fix manually." >&2
                exit 1
            fi
        done
    fi

    # Fetch the version index page
    top=$(curl -fsSL --retry 3 --retry-delay 5 "${ver_url}/")

    # Discover architecture subdirectories
    archdirs=$(echo "${top}" \
        | grep -oP 'href="\K[a-z0-9]+(?=/")' \
        | grep -vE '^(BUILT|CHANGES|HEADER|FOOTER)' | sort -u || true)

    # Check which upstream debs are missing locally
    needs_download=false
    for archdir in ${archdirs}; do
        arch_page=$(curl -fsSL --retry 3 --retry-delay 5 "${ver_url}/${archdir}/" 2>/dev/null) || continue
        arch_debs=$(echo "${arch_page}" \
            | grep -oP "href=\"\Klinux-headers-[^\"]+_${archdir}\.deb" | sort -u || true)
        common_debs=$(echo "${arch_page}" \
            | grep -oP 'href="\Klinux-headers-[^"]+_all\.deb' | sort -u || true)

        for deb in ${arch_debs} ${common_debs}; do
            if [ -f "${out_dir}/${deb}" ]; then
                continue
            fi

            # Download from upstream
            echo "  GET ${archdir}/${deb}"
            curl -fsSL --retry 3 --retry-delay 5 -o "${out_dir}/${deb}" "${ver_url}/${archdir}/${deb}"
            needs_download=true
        done
    done

    if [ "${needs_download}" = true ]; then
        new_versions=$((new_versions + 1))
    else
        echo ">>> ${ver_dir}: all debs present and valid."
    fi
done

if [ ${new_versions} -eq 0 ]; then
    echo "=== No new versions found, nothing to do. ==="
    "${script_dir}/get-archive-annotation" "${archive_tag}" "dev.mainline-kernel-headers.versions" || true
    exit 0
fi

echo "=== Fetching complete (${new_versions} new version(s)) ==="

# ---------------------------------------------------------------------------
# Step 2: Build the archive image
# ---------------------------------------------------------------------------
echo ""
echo "=== Building archive: ${archive_tag} ==="

archive_args=(
    --build-arg "KVER=${kver}"
)

if docker buildx imagetools inspect "${archive_tag}" >/dev/null 2>&1; then
    echo "  (incremental: previous archive found)"
    archive_args+=(--build-arg "ARCHIVE_IMAGE=${archive_tag}")
else
    echo "  (cold start: no previous archive)"
    archive_args+=(--build-arg "ARCHIVE_IMAGE=scratch")
fi

# Build and load into local docker daemon (temporary tag for extraction)
docker rmi "${archive_tag}-tmp" >/dev/null 2>&1 || true
docker buildx build \
    -f "${repo_dir}/Dockerfile.archive" \
    "${archive_args[@]}" \
    -t "${archive_tag}-tmp" \
    --load \
    "${repo_dir}"

# Extract version info by scanning .deb filenames in the archive
echo ""
echo "--- Extracting version info from archive ---"
versions_json=$(docker run --rm "${archive_tag}-tmp" /bin/ls -R "/${kver}/" 2>/dev/null \
    | python3 -c "
import sys, re, json
from collections import defaultdict

versions = defaultdict(set)
current_ver = ''
for line in sys.stdin.read().strip().splitlines():
    if line.endswith(':'):
        m = re.search(r'/(\d+\.\d+\.\d+):$', line)
        current_ver = m.group(1) if m else ''
        continue
    if not current_ver or not line.endswith('.deb'):
        continue
    fname = line.strip()
    if fname.endswith('_all.deb'):
        continue
    m = re.search(r'_([^_]+)\.deb$', fname)
    if m:
        versions[current_ver].add(m.group(1))

if versions:
    result = {k: ','.join(sorted(v)) for k, v in sorted(versions.items())}
    print(json.dumps(result, separators=(',', ':')))
") || true

annotation_args=()
if [ -n "${versions_json}" ]; then
    echo "  Versions: ${versions_json}"
    annotation_args+=(--annotation "manifest:org.opencontainers.image.description=Mainline kernel header .deb archive for series ${kver}")
    annotation_args+=(--annotation "manifest:dev.mainline-kernel-headers.versions=${versions_json}")
fi

# Rebuild with annotations (cached, just updates metadata) and push if requested
push_flag=()
if [ "${push}" = true ]; then
    push_flag=(--push)
fi

echo ""
echo "--- Loading with annotations${push:+ and pushing} ---"
docker rmi "${archive_tag}" >/dev/null 2>&1 || true
docker buildx build \
    -f "${repo_dir}/Dockerfile.archive" \
    "${archive_args[@]}" \
    "${annotation_args[@]}" \
    -t "${archive_tag}" \
    --load "${push_flag[@]}" \
    "${repo_dir}"

docker rmi "${archive_tag}-tmp" >/dev/null 2>&1

echo ""
"${script_dir}/get-archive-annotation" "${archive_tag}" "dev.mainline-kernel-headers.versions" || true

echo ""
echo "=== Done: ${archive_tag} ==="
