#!/usr/bin/env python3
"""Build the Ubuntu generic kernel headers image for a given Ubuntu series.

Examples:
    ./scripts/build-ubuntu noble
    ./scripts/build-ubuntu noble --push
    ./scripts/build-ubuntu noble --push --image myrepo/kernel-headers
    ./scripts/build-ubuntu noble --push --platforms linux/amd64,linux/arm64
    ./scripts/build-ubuntu noble --limit 0   # install all kernels (no cap)
"""

import argparse
import json
import os
import re
import subprocess
import sys
from collections import defaultdict

_script_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, _script_dir)

from lib import (ARCHIVE_ANNOTATION_VERSIONS_KEY, IMAGE_PREFIX,
                 check_containerd_snapshotter, detect_platforms,
                 enumerate_installed_headers_packages,
                 inspect_platform_annotation)


def _build_ubuntu_versions(
    image: str, platform: str,
) -> dict[str, list[str]]:
    """Build {flavour: [kabis]} from installed headers packages."""
    flavours: dict[str, set[str]] = defaultdict(set)
    for pkg in enumerate_installed_headers_packages(image, platform) or []:
        m = re.match(r"^linux-headers-(\d+\.\d+\.\d+-\d+)-(.+)$", pkg)
        if m:
            flavours[m.group(2)].add(m.group(1))
    return {f: sorted(v) for f, v in sorted(flavours.items())}


def build_ubuntu(
    series: str,
    push: bool = False,
    scratch: bool = False,
    limit: int | None = None,
    image_prefix: str = IMAGE_PREFIX,
    platforms: str = "",
    suite: str = "",
    release: str = "",
) -> None:
    """Build the Ubuntu generic kernel headers image for a series."""
    repo_dir = os.path.dirname(_script_dir)
    generic_tag = f"{image_prefix}:{series}-generic"
    dkms_tag = f"{image_prefix}:{series}-dkms"

    check_containerd_snapshotter()

    print(f"\n=== Building Ubuntu headers: {generic_tag} ===", file=sys.stderr)

    # Determine base image
    if not scratch and subprocess.run(
        ["docker", "buildx", "imagetools", "inspect", generic_tag],
        capture_output=True,
    ).returncode == 0:
        print("  (incremental: previous headers image found)", file=sys.stderr)
        base_image = generic_tag
    else:
        print(f"  (cold start: using {dkms_tag} as base)", file=sys.stderr)
        base_image = dkms_tag

    # Auto-detect platforms
    if not platforms:
        detected = detect_platforms(base_image)
        if not detected:
            print(f"ERROR: could not detect platforms from base image {base_image}",
                  file=sys.stderr)
            sys.exit(1)
        platforms = ",".join(detected)
        print(f"  (detected platforms from base: {platforms})", file=sys.stderr)

    common_image_args = [
        "--platform", platforms,
        "--build-arg", f"SERIES={series}",
        "--build-arg", f"BASE_IMAGE={base_image}",
        "-f", os.path.join(repo_dir, "ubuntu", "Dockerfile.ubuntu"),
    ]
    if limit is not None:
        common_image_args += ["--build-arg", f"MAX_KERNELS={limit}"]

    # Build (first pass — load locally to extract version info)
    tmp_tag = f"{generic_tag}-tmp"
    print("\n--- Building multi-platform install (tmp) ---", file=sys.stderr)
    subprocess.run(["docker", "rmi", tmp_tag], capture_output=True)
    subprocess.run(["docker", "buildx", "build",
                    *common_image_args, "-t", tmp_tag, "--load", repo_dir],
                   check=True)

    # Extract per-platform version annotations
    print("\n--- Extracting per-platform version info ---", file=sys.stderr)

    annotation_args = [
        "--annotation",
        f"index:org.opencontainers.image.description="
        f"Ubuntu generic kernel headers for {series}",
    ]

    for plat in platforms.split(","):
        print(f"  Extracting versions for {plat} ...", file=sys.stderr)
        plat_versions = _build_ubuntu_versions(tmp_tag, plat)
        versions_json = json.dumps(plat_versions, separators=(",", ":"))
        print(f"    Versions: {versions_json}", file=sys.stderr)
        annotation_args += [
            "--annotation",
            f"manifest-descriptor[{plat}]:{ARCHIVE_ANNOTATION_VERSIONS_KEY}={versions_json}",
        ]

    # Rebuild with annotations and push/load
    action = "Pushing" if push else "Loading"
    print(f"\n--- {action} with annotations ---", file=sys.stderr)

    # Build alias tags
    alias_tags = ["-t", f"{image_prefix}:{series}"]
    if suite:
        alias_tags += ["-t", f"{image_prefix}:{suite}-generic",
                       "-t", f"{image_prefix}:{suite}"]
    if release:
        alias_tags += ["-t", f"{image_prefix}:{release}-generic",
                       "-t", f"{image_prefix}:{release}"]

    subprocess.run(["docker", "rmi", generic_tag], capture_output=True)
    subprocess.run(["docker", "buildx", "build",
                    *common_image_args, *annotation_args,
                    "-t", generic_tag, *alias_tags,
                    *(["--push"] if push else ["--load"]),
                    repo_dir],
                   check=True)

    # Clean up tmp tag
    subprocess.run(["docker", "rmi", tmp_tag], capture_output=True)

    # Inspect results
    print("\n--- Install image inspection ---", file=sys.stderr)
    for plat in platforms.split(","):
        val = inspect_platform_annotation(
            generic_tag, plat, ARCHIVE_ANNOTATION_VERSIONS_KEY, pushed=push)
        print(f"  {plat}: {ARCHIVE_ANNOTATION_VERSIONS_KEY}={val or '<none>'}",
              file=sys.stderr)

    print(f"\n=== Done: {series} ===", file=sys.stderr)
    print(f"  Generic: {generic_tag}", file=sys.stderr)
    print(f"  Aliases: {' '.join(alias_tags)}", file=sys.stderr)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Build the Ubuntu generic kernel headers image for a series.")
    parser.add_argument("series", help="Ubuntu series codename (e.g. 'noble')")
    parser.add_argument("--push", action="store_true",
                        help="Push to registry (default: load locally)")
    parser.add_argument("--scratch", action="store_true",
                        help="Cold start (ignore existing generic image)")
    parser.add_argument("--limit", type=int, default=None,
                        help="Max kernels to install (0 = no cap)")
    parser.add_argument("--image", default=IMAGE_PREFIX, dest="image_prefix",
                        help="Image prefix (default: %(default)s)")
    parser.add_argument("--platforms", default="",
                        help="Comma-separated platforms (auto-detected if omitted)")
    parser.add_argument("--suite", default="",
                        help="Suite name for alias tags (e.g. 'noble-updates')")
    parser.add_argument("--release", default="",
                        help="Release version for alias tags (e.g. '24.04')")
    args = parser.parse_args()

    build_ubuntu(args.series, push=args.push, scratch=args.scratch,
                 limit=args.limit, image_prefix=args.image_prefix,
                 platforms=args.platforms, suite=args.suite,
                 release=args.release)


if __name__ == "__main__":
    main()
