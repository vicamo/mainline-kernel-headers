#!/usr/bin/env python3
"""Build the mainline image for a given kernel version.

Requires the archive image to already exist.

Examples:
    ./scripts/build-mainline 7.0
    ./scripts/build-mainline 7.0 --push
    ./scripts/build-mainline 7.0 --push --image myrepo/kernel-headers
    ./scripts/build-mainline 7.0 --push --platforms linux/amd64,linux/arm64
    ./scripts/build-mainline 7.0 --limit 0   # install all kernels (no cap)
"""

import argparse
import json
import os
import re
import subprocess
import sys
from collections import defaultdict
from pathlib import Path

_script_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, _script_dir)

from lib import (ARCHIVE_ANNOTATION_VERSIONS_KEY, IMAGE_PREFIX,
                 MAINLINE_ANNOTATION_CREATED_KEY, check_containerd_snapshotter,
                 detect_platforms, enumerate_installed_headers_packages,
                 get_index_annotation, inspect_platform_annotation)
from lib.series import series_for_kver

# Re-use get_archive_annotation
_annotation_path = os.path.join(_script_dir, "get-archive-annotation")
_annotation_ns: dict = {"__file__": _annotation_path}
exec(compile(Path(_annotation_path).read_text(), _annotation_path, "exec"), _annotation_ns)
get_archive_annotation = _annotation_ns["get_archive_annotation"]


def _build_mainline_versions(
    image: str, platform: str,
) -> dict[str, list[str]]:
    """Build {flavour: [versions]} from installed headers packages."""
    flavours: dict[str, set[str]] = defaultdict(set)
    for pkg in enumerate_installed_headers_packages(image, platform) or []:
        m = re.match(r"linux-headers-(\d+\.\d+\.\d+)-([a-z0-9]+)-(.+)", pkg)
        if not m:
            continue
        ver = m.group(1)
        # Normalize: strip trailing .0 (e.g. 7.0.0 -> 7.0)
        if ver.endswith(".0") and ver.count(".") == 2:
            ver = ver[:-2]
        flavours[m.group(3)].add(ver)
    return {f: sorted(v) for f, v in sorted(flavours.items())}


def build_mainline(
    kver: str,
    push: bool = False,
    force: bool = False,
    scratch: bool = False,
    limit: int | None = None,
    image_prefix: str = IMAGE_PREFIX,
    platforms: str = "",
) -> None:
    """Build the mainline image for a kernel version."""
    repo_dir = os.path.dirname(_script_dir)
    archive_tag = f"{image_prefix}:{kver}-archive"
    image_tag = f"{image_prefix}:{kver}"

    check_containerd_snapshotter()

    # Verify archive image exists and capture its created timestamp
    archive_created = get_archive_annotation(
        archive_tag, "org.opencontainers.image.created")
    if not archive_created:
        print(f"ERROR: archive image {archive_tag} not found. Run build-archive first.",
              file=sys.stderr)
        sys.exit(1)

    # Check if mainline image is already up to date
    print(f"\n=== Building image: {image_tag} ===", file=sys.stderr)

    if not force and not scratch:
        existing_created = get_index_annotation(
            image_tag, MAINLINE_ANNOTATION_CREATED_KEY)
        if existing_created and existing_created == archive_created:
            print(f"  Mainline image already matches archive (created: {archive_created})",
                  file=sys.stderr)
            print(f"\n=== Done: {kver} (up to date) ===", file=sys.stderr)
            return

    # Determine base image
    common_image_args = [
        "-f", os.path.join(repo_dir, "mainline", "Dockerfile.mainline"),
        "--build-arg", f"KVER={kver}",
        "--build-arg", f"ARCHIVE_IMAGE={archive_tag}",
    ]

    if not scratch and subprocess.run(
        ["docker", "buildx", "imagetools", "inspect", image_tag],
        capture_output=True,
    ).returncode == 0:
        print("  (incremental: previous mainline image found)", file=sys.stderr)
        base_image = image_tag
    else:
        series = series_for_kver(kver)
        dkms_tag = f"{image_prefix}:{series}-dkms"
        print(f"  (cold start: using {dkms_tag} as base)", file=sys.stderr)
        base_image = dkms_tag

    common_image_args += ["--build-arg", f"BASE_IMAGE={base_image}"]

    # Auto-detect platforms if not specified
    if not platforms:
        detected = detect_platforms(base_image)
        if not detected:
            print(f"ERROR: could not detect platforms from base image {base_image}",
                  file=sys.stderr)
            sys.exit(1)
        platforms = ",".join(detected)
        print(f"  (detected platforms from base: {platforms})", file=sys.stderr)

    common_image_args += ["--platform", platforms]

    if limit is not None:
        common_image_args += ["--build-arg", f"MAX_KERNELS={limit}"]

    # Build all platforms (tmp tag)
    tmp_tag = f"{image_tag}-tmp"
    print("\n--- Building multi-platform install (tmp) ---", file=sys.stderr)
    subprocess.run(["docker", "rmi", tmp_tag], capture_output=True)
    subprocess.run(["docker", "buildx", "build",
         *common_image_args, "-t", tmp_tag, "--load", repo_dir],
        check=True)

    # Extract per-platform version info
    print("\n--- Extracting per-platform version info ---", file=sys.stderr)

    annotation_args = [
        "--annotation", f"index:org.opencontainers.image.description="
                        f"Mainline kernel headers for {kver}",
        "--annotation", f"index:{MAINLINE_ANNOTATION_CREATED_KEY}={archive_created}",
    ]

    for plat in platforms.split(","):
        print(f"  Extracting versions for {plat} ...", file=sys.stderr)
        plat_versions = _build_mainline_versions(tmp_tag, plat)
        versions_json = json.dumps(plat_versions, separators=(",", ":"))
        print(f"    Versions: {versions_json}", file=sys.stderr)
        annotation_args += [
            "--annotation",
            f"manifest-descriptor[{plat}]:{ARCHIVE_ANNOTATION_VERSIONS_KEY}={versions_json}",
        ]

    # Rebuild with annotations
    action = "Pushing" if push else "Loading"
    print(f"\n--- {action} with annotations ---", file=sys.stderr)
    subprocess.run(["docker", "rmi", image_tag], capture_output=True)
    subprocess.run(["docker", "buildx", "build",
         *common_image_args, *annotation_args,
         "-t", image_tag,
         *(["--push"] if push else ["--load"]),
         repo_dir],
        check=True)

    # Clean up tmp tag
    subprocess.run(["docker", "rmi", tmp_tag], capture_output=True)

    # Inspect final annotations
    print("\n--- Install image inspection ---", file=sys.stderr)
    for plat in platforms.split(","):
        val = inspect_platform_annotation(
            image_tag, plat, ARCHIVE_ANNOTATION_VERSIONS_KEY, pushed=push)
        print(f"  {plat}: {ARCHIVE_ANNOTATION_VERSIONS_KEY}={val or '<none>'}",
              file=sys.stderr)

    print(f"\n=== Done: {kver} ===", file=sys.stderr)
    print(f"  Archive: {archive_tag}", file=sys.stderr)
    print(f"  Mainline: {image_tag}", file=sys.stderr)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Build the mainline image for a given kernel version.")
    parser.add_argument("kver", help="Kernel series (e.g. '7.0')")
    parser.add_argument("--push", action="store_true",
                        help="Push to registry (default: load locally)")
    parser.add_argument("--force", action="store_true",
                        help="Rebuild even if up to date with archive")
    parser.add_argument("--scratch", action="store_true",
                        help="Cold start (ignore existing mainline image)")
    parser.add_argument("--limit", type=int, default=None,
                        help="Max kernels to install (0 = no cap)")
    parser.add_argument("--image", default=IMAGE_PREFIX, dest="image_prefix",
                        help="Image prefix (default: %(default)s)")
    parser.add_argument("--platforms", default="",
                        help="Comma-separated platforms (auto-detected if omitted)")
    args = parser.parse_args()

    build_mainline(args.kver, push=args.push, force=args.force,
                   scratch=args.scratch, limit=args.limit,
                   image_prefix=args.image_prefix, platforms=args.platforms)


if __name__ == "__main__":
    main()
