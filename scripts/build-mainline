#!/usr/bin/env bash
#
# Build the mainline image for a given kernel version.
# Requires the archive image to already exist.
#
# Usage:
#   ./scripts/build-mainline <KVER> [--push] [--scratch] [--limit N] [--image PREFIX] [--platforms PLATFORMS]
#
# Examples:
#   ./scripts/build-mainline 7.0
#   ./scripts/build-mainline 7.0 --push
#   ./scripts/build-mainline 7.0 --push --image myrepo/kernel-headers
#   ./scripts/build-mainline 7.0 --push --platforms linux/amd64,linux/arm64
#   ./scripts/build-mainline 7.0 --limit 0   # install all kernels (no cap)
#
set -euo pipefail

# Require containerd-snapshotter for multi-platform --load and local annotations.
if ! docker info -f '{{.DriverStatus}}' 2>/dev/null | grep -q 'io.containerd.snapshotter'; then
    echo "ERROR: containerd-snapshotter not enabled in Docker daemon." >&2
    echo "Multi-platform --load requires containerd image store." >&2
    exit 1
fi

script_dir="$(cd "$(dirname "$0")" && pwd)"
repo_dir="$(dirname "${script_dir}")"

push=
force=
scratch=
limit=
kver=""
image_prefix="ghcr.io/vicamo/linux-headers"
platforms=""

while [ $# -gt 0 ]; do
    case "$1" in
        --push)          push=--push; shift ;;
        --force)         force=1; shift ;;
        --scratch)       scratch=1; shift ;;
        --limit)         limit="$2"; shift 2 ;;
        --image)         image_prefix="$2"; shift 2 ;;
        --platforms)     platforms="$2"; shift 2 ;;
        -*)              echo "Unknown flag: $1" >&2; exit 1 ;;
        *)               kver="$1"; shift ;;
    esac
done

if [ -z "${kver}" ]; then
    echo "Usage: $0 <KVER> [--push] [--force] [--scratch] [--limit N] [--image PREFIX] [--platforms PLATFORMS]" >&2
    exit 1
fi

archive_tag="${image_prefix}:${kver}-archive"
image_tag="${image_prefix}:${kver}"

# Verify archive image exists and capture its created timestamp
archive_created=$("${script_dir}/get-archive-annotation" "${archive_tag}" "org.opencontainers.image.created" 2>/dev/null) || true
if [ -z "${archive_created}" ]; then
    echo "ERROR: archive image ${archive_tag} not found. Run build-archive first." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Build the mainline image (multi-platform)
# ---------------------------------------------------------------------------
echo ""
echo "=== Building image: ${image_tag} ==="

# Check if the install image is already up to date with the archive.
# Compare the archive created timestamp against what the mainline image recorded.
if docker buildx imagetools inspect "${image_tag}" >/dev/null 2>&1; then
    mainline_archive_created=$(docker buildx imagetools inspect "${image_tag}" --raw 2>/dev/null \
        | python3 -c "
import json, sys
data = json.load(sys.stdin)
annotations = data.get('annotations') or {}
v = annotations.get('dev.mainline-kernel-headers.archive-created', '')
if v:
    print(v)
" 2>/dev/null) || true

    if [ -z "${force}" ] && [ -n "${mainline_archive_created}" ] && [ "${archive_created}" = "${mainline_archive_created}" ]; then
        echo "  Mainline image already matches archive (created: ${archive_created})"
        echo ""
        echo "--- Install image inspection ---"
        docker buildx imagetools inspect "${image_tag}" --raw 2>/dev/null || true
        echo ""
        echo "=== Done: ${kver} (up to date) ==="
        exit 0
    fi
fi

# Determine the appropriate Ubuntu base image for cold-start builds.
# Ubuntu release kernel versions (codename -> release kernel):
#   Jammy    (22.04) -> 5.15
#   Kinetic  (22.10) -> 5.19
#   Lunar    (23.04) -> 6.2
#   Mantic   (23.10) -> 6.5
#   Noble    (24.04) -> 6.8
#   Oracular (24.10) -> 6.11
#   Plucky   (25.04) -> 6.14
#   Questing (25.10) -> 6.17
#   Resolute (26.04) -> 7.0
#
# We pick the newest Ubuntu release whose kernel version <= KVER.
# Format: "major_minor codename" sorted descending.
# Series lookup helper (uses scripts/lib/series.py)
_series_for_kver() {
    python3 -c "
import sys; sys.path.insert(0, '${script_dir}')
from lib.series import series_for_kver
print(series_for_kver('$1'${2:+, longterm=True}))
"
}

common_image_args=(
    -f "${repo_dir}/mainline/Dockerfile.mainline"
    --build-arg "KVER=${kver}"
    --build-arg "ARCHIVE_IMAGE=${archive_tag}"
)

if [ -z "${scratch}" ] && docker buildx imagetools inspect "${image_tag}" >/dev/null 2>&1; then
    echo "  (incremental: previous mainline image found)"
    base_image="${image_tag}"
else
    series=$(_series_for_kver "${kver}")
    dkms_tag="${image_prefix}:${series}-dkms"
    echo "  (cold start: using ${dkms_tag} as base)"
    base_image="${dkms_tag}"
fi
common_image_args+=(--build-arg "BASE_IMAGE=${base_image}")

# Auto-detect available platforms from the base image if not explicitly set.
if [ -z "${platforms}" ]; then
    platforms=$(docker buildx imagetools inspect "${base_image}" --raw 2>/dev/null \
        | python3 -c "
import json, sys
data = json.load(sys.stdin)
platforms = []
for m in data.get('manifests', []):
    ann = m.get('annotations') or {}
    if 'attestation' in ann.get('vnd.docker.reference.type', ''):
        continue
    p = m.get('platform', {})
    if p.get('os') == 'unknown':
        continue
    plat = p.get('os', '') + '/' + p.get('architecture', '')
    if p.get('variant'):
        plat += '/' + p['variant']
    platforms.append(plat)
if platforms:
    print(','.join(platforms))
" 2>/dev/null) || true

    if [ -z "${platforms}" ]; then
        echo "ERROR: could not detect platforms from base image ${base_image}" >&2
        exit 1
    fi
    echo "  (detected platforms from base: ${platforms})"
fi
common_image_args+=(--platform "${platforms}")


[ -z "${limit}" ] || common_image_args+=(--build-arg MAX_KERNELS="${limit}")

# Build all platforms and load locally (tmp tag)
tmp_tag="${image_tag}-tmp"
echo ""
echo "--- Building multi-platform install (tmp) ---"
docker rmi "${tmp_tag}" >/dev/null 2>&1 || true
docker buildx build \
    "${common_image_args[@]}" \
    -t "${tmp_tag}" \
    --load \
    "${repo_dir}"

# Extract per-platform version info
echo ""
echo "--- Extracting per-platform version info ---"

annotation_args=()
annotation_args+=(--annotation "index:org.opencontainers.image.description=Mainline kernel headers for ${kver}")
annotation_args+=(--annotation "index:dev.mainline-kernel-headers.archive-created=${archive_created}")

IFS=',' read -ra plats <<< "${platforms}"
for plat in "${plats[@]}"; do
    echo "  Extracting versions for ${plat} ..."
    plat_versions=$(
        docker save --platform "${plat}" "${tmp_tag}" 2>/dev/null \
            | python3 -c "
import tarfile, json, io, sys, re

tar = tarfile.open(fileobj=sys.stdin.buffer, mode='r|')

# First pass: read all members into memory
content = {}
for member in tar:
    if member.isfile():
        data = tar.extractfile(member).read()
        content[member.name] = data

# Determine format: OCI (index.json) or Docker (manifest.json)
if 'index.json' in content:
    # OCI layout
    idx = json.loads(content['index.json'])
    manifest_desc = idx['manifests'][0]
    manifest_blob = content['blobs/' + manifest_desc['digest'].replace(':', '/')]
    manifest = json.loads(manifest_blob)
    layers = [content['blobs/' + l['digest'].replace(':', '/')] for l in manifest['layers']]
else:
    # Docker format
    mf = json.loads(content['manifest.json'])
    layers = [content[l] for l in mf[0]['Layers']]

# Extract var/lib/dpkg/status from the topmost layer that has it
dpkg_status = None
for layer_data in layers:
    try:
        lt = tarfile.open(fileobj=io.BytesIO(layer_data), mode='r:*')
        for m in lt:
            if m.name in ('var/lib/dpkg/status', './var/lib/dpkg/status'):
                dpkg_status = lt.extractfile(m).read().decode()
                break
        lt.close()
    except Exception:
        pass

if not dpkg_status:
    sys.exit(0)

# {version: set(flavours)}
from collections import defaultdict
versions = defaultdict(set)
for block in dpkg_status.split('\n\n'):
    if 'Package: linux-headers-' not in block:
        continue
    pkg = arch = ''
    for line in block.splitlines():
        if line.startswith('Package: '):
            pkg = line[9:]
        elif line.startswith('Architecture: '):
            arch = line[14:]
    if pkg.startswith('linux-headers-') and arch and arch != 'all':
        # linux[-<derived>]-headers-<ver>-<abi>-<flavour>
        m = re.match(r'linux(?:-.+)?-headers-(\d+\.\d+(?:\.\d+)?)-\d+-(.+)', pkg)
        if m:
            ver = m.group(1)
            # Normalize: strip trailing .0 (e.g. 7.0.0 -> 7.0)
            if ver.endswith('.0') and ver.count('.') == 2:
                ver = ver[:-2]
            versions[ver].add(m.group(2))
if versions:
    result = {v: sorted(f) for v, f in sorted(versions.items())}
    print(json.dumps(result, separators=(',', ':')))
" 2>/dev/null
    ) || true

    if [ -n "${plat_versions}" ]; then
        echo "    Versions: ${plat_versions}"
        annotation_args+=(--annotation "manifest-descriptor[${plat}]:dev.mainline-kernel-headers.versions=${plat_versions}")
    fi
done

# Rebuild with annotations
echo ""
echo "--- ${push:+Pushing}${push:-Loading} with annotations ---"

docker rmi "${image_tag}" >/dev/null 2>&1 || true
docker buildx build \
    "${common_image_args[@]}" \
    "${annotation_args[@]}" \
    -t "${image_tag}" \
    ${push:---load} \
    "${repo_dir}"

# Clean up tmp tag
docker rmi "${tmp_tag}" >/dev/null 2>&1 || true

echo ""
echo "--- Install image inspection ---"
IFS=',' read -ra plats <<< "${platforms}"
for plat in "${plats[@]}"; do
    if [ -n "${push}" ]; then
        val=$(docker buildx imagetools inspect "${image_tag}" --raw 2>/dev/null \
            | python3 -c "
import json, sys
data = json.load(sys.stdin)
for m in data.get('manifests', []):
    p = m.get('platform', {})
    plat_str = p.get('os','') + '/' + p.get('architecture','')
    if p.get('variant'):
        plat_str += '/' + p['variant']
    if plat_str == '${plat}':
        print(m.get('annotations', {}).get('dev.mainline-kernel-headers.versions', ''))
        break
" 2>/dev/null) || true
    else
        val=$(docker image inspect --platform "${plat}" "${image_tag}" \
            --format '{{index .Descriptor.Annotations "dev.mainline-kernel-headers.versions"}}' 2>/dev/null) || true
    fi
    echo "  ${plat}: dev.mainline-kernel-headers.versions=${val:-<none>}"
done

echo ""
echo "=== Done: ${kver} ==="
echo "  Archive: ${archive_tag}"
echo "  Mainline: ${image_tag}"
