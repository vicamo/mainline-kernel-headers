#!/usr/bin/env python3
"""
Generate a gap report for mainline-kernel-headers Docker images.

Usage:
    report-gaps [OPTIONS] [SERIES...]

Options:
    --format markdown|json   Output format (default: markdown)
    --json                   Shorthand for --format json
    --from-json              Read JSON data from stdin and render as markdown.
                             Ignores SERIES args; skips all network/docker queries.

When no SERIES are given, discovers active (non-EOL) series from kernel.org.

Outputs GitHub-flavored Markdown suitable for $GITHUB_STEP_SUMMARY,
or structured JSON as an intermediate representation.

For each kernel series, compares:
  1. Versions available on kernel.ubuntu.com/mainline (upstream)
  2. Versions archived in the Docker archive image (per-arch .deb availability)
  3. Versions installed in the Docker headers image (per-platform)

Icons indicate root cause:
  ✅ - available and installed
  ⚪ - not available upstream (no .deb for this arch on kernel.ubuntu.com)
  🔺 - in archive but not in headers image (needs rebuild)
  ❌ - available upstream but not in archive (archive needs rebuild)
  ⬛ - no Docker image exists for this series
"""

import json
import re
import subprocess
import sys
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed

IMAGE_PREFIX = "vicamo/mainline-kernel-headers"
BASE_URL = "https://kernel.ubuntu.com/mainline"
ARCHS = ["amd64", "arm64", "armhf", "ppc64el", "s390x"]
OCI_TO_DEB = {
    "linux/amd64": "amd64",
    "linux/arm64": "arm64",
    "linux/arm": "armhf",
    "linux/arm/v7": "armhf",
    "linux/ppc64le": "ppc64el",
    "linux/s390x": "s390x",
}


def fetch(url):
    try:
        with urllib.request.urlopen(url, timeout=30) as r:
            return r.read().decode()
    except Exception:
        return None


def get_active_series():
    data = fetch("https://www.kernel.org/releases.json")
    if not data:
        print("ERROR: cannot fetch kernel.org releases", file=sys.stderr)
        sys.exit(1)
    releases = json.loads(data)
    seen = set()
    series = []
    for r in releases["releases"]:
        if r["moniker"] not in ("stable", "longterm"):
            continue
        if r["iseol"]:
            continue
        m = re.match(r"^(\d+\.\d+)", r["version"])
        if m:
            s = m.group(1)
            if s not in seen:
                seen.add(s)
                series.append(s)
    return series


def get_upstream_versions(kver):
    """Discover versions available on kernel.ubuntu.com/mainline for a series."""
    index = fetch(f"{BASE_URL}/")
    if not index:
        return {}
    pattern = re.compile(rf'href="v({re.escape(kver)}(?:\.\d+)?)/?"')
    versions = sorted(set(pattern.findall(index)), key=lambda v: list(map(int, v.split("."))))

    # _all.deb may only appear in one subdir (e.g. amd64) but applies to all.
    # An arch is "available" if it has _ARCH.deb AND _all.deb exists anywhere.
    def check_version(v):
        ver_url = f"{BASE_URL}/v{v}/"
        page = fetch(ver_url)
        if not page:
            return v, set()
        archdirs = set(re.findall(r'href="([a-z0-9]+)/"', page)) - {
            "BUILT", "CHANGES", "HEADER", "FOOTER"
        }
        found_archs = set()
        has_all_deb = False

        if archdirs:
            # Newer layout: debs are inside arch subdirectories
            for ad in archdirs:
                arch_page = fetch(f"{ver_url}{ad}/")
                if not arch_page:
                    continue
                if not has_all_deb:
                    has_all_deb = bool(re.search(r'linux-headers-[^"]+_all\.deb', arch_page))
                if re.search(rf'linux-headers-[^"]+_{ad}\.deb', arch_page):
                    found_archs.add(ad)
        else:
            # Flat layout (older kernels): debs are on the version page
            has_all_deb = bool(re.search(r'linux-headers-[^"]+_all\.deb', page))
            for arch in ARCHS:
                if re.search(rf'linux-headers-[^"]+_{arch}\.deb', page):
                    found_archs.add(arch)

        if not has_all_deb:
            return v, set()
        return v, found_archs

    result = {}
    with ThreadPoolExecutor(max_workers=8) as pool:
        futures = {pool.submit(check_version, v): v for v in versions}
        for f in as_completed(futures):
            v, archs = f.result()
            result[v] = archs
    return result


def inspect_image_raw(tag):
    try:
        r = subprocess.run(
            ["docker", "buildx", "imagetools", "inspect", tag, "--raw"],
            capture_output=True, text=True, timeout=30,
        )
        if r.returncode == 0:
            return json.loads(r.stdout)
    except Exception:
        pass
    return None


def get_archive_info(kver):
    tag = f"{IMAGE_PREFIX}:{kver}-archive"
    key = "dev.mainline-kernel-headers.versions"
    try:
        r = subprocess.run(
            ["./scripts/get-archive-annotation", tag, key],
            capture_output=True, text=True, timeout=60,
        )
        versions_str = r.stdout.strip()
        if r.returncode != 0 or not versions_str:
            return None
        v = json.loads(versions_str)
        # Format: {version: {arch: [flavours]}}
        return v
    except Exception:
        return None


def get_install_info(kver):
    tag = f"{IMAGE_PREFIX}:{kver}"
    data = inspect_image_raw(tag)
    if not data:
        return None
    result = {}
    for m in data.get("manifests", []):
        plat = m.get("platform", {})
        if plat.get("os", "") != "linux":
            continue
        arch = plat.get("architecture", "")
        variant = plat.get("variant", "")
        oci_plat = f"linux/{arch}/{variant}" if variant else f"linux/{arch}"
        deb_arch = OCI_TO_DEB.get(oci_plat) or OCI_TO_DEB.get(f"linux/{arch}")
        if not deb_arch:
            continue
        ann = m.get("annotations", {})
        versions_str = ann.get("dev.mainline-kernel-headers.versions", "")
        if versions_str:
            # Format: {version: [flavours]}
            result[deb_arch] = json.loads(versions_str)
        else:
            result[deb_arch] = {}
    return result


def version_sort_key(v):
    return tuple(int(p) for p in v.split("."))


def json_to_markdown(data):
    """Render JSON report data as GitHub-flavored Markdown."""
    lines = []
    lines.append("# Mainline Kernel Headers — Gap Report\n")
    lines.append("| Icon | Meaning |")
    lines.append("|------|---------|")
    lines.append("| ✅ | Available and installed |")
    lines.append("| ⚪ | Not available upstream (no .deb for this arch) |")
    lines.append("| 🔺 | In archive but not in headers image (stale) |")
    lines.append("| ❌ | Available upstream but not in archive (archive stale) |")
    lines.append("| ⬛ | No Docker image exists for this series |")
    lines.append("")

    status_icon = {
        "ok": "✅",
        "unavailable": "⚪",
        "missing_archive": "❌",
        "missing_install": "🔺",
    }

    series_data = data.get("series", {})
    for kver in sorted(series_data.keys(), key=version_sort_key):
        info = series_data[kver]
        lines.append(f"## Series {kver}\n")

        versions = info.get("versions", {})
        archs = info.get("archs", ARCHS)
        has_archive = info.get("has_archive", False)
        has_install = info.get("has_install", False)

        if not versions:
            lines.append("> No versions found upstream.\n")
            continue

        if not has_archive and not has_install:
            lines.append(f"> ⬛ No Docker images exist yet ({len(versions)} versions upstream)\n")
            continue

        all_versions = sorted(versions.keys(), key=version_sort_key)

        gap_rows = []
        for v in all_versions:
            arch_status = versions[v]
            cells = []
            has_gap = False
            for arch in archs:
                status = arch_status.get(arch, "ok")
                cells.append(status_icon.get(status, "?"))
                if status != "ok":
                    has_gap = True
            if has_gap:
                gap_rows.append((v, cells))

        if not gap_rows:
            lines.append(f"✅ All {len(all_versions)} versions fully available across all architectures.\n")
        else:
            lines.append(f"| Version | {' | '.join(archs)} |")
            lines.append(f"|---------|{'|'.join([':---:'] * len(archs))}|")
            for v, cells in gap_rows:
                lines.append(f"| [``{v}``](https://kernel.ubuntu.com/mainline/v{v}/) | {' | '.join(cells)} |")
            lines.append("")
            lines.append(f"_{len(gap_rows)}/{len(all_versions)} versions have gaps_\n")

            complete = [v for v in all_versions if v not in {r[0] for r in gap_rows}]
            if complete:
                links = ", ".join(f"[v{v}](https://kernel.ubuntu.com/mainline/v{v}/)" for v in complete)
                lines.append(f"<details><summary>✅ {len(complete)} complete versions</summary>\n")
                lines.append(f"{links}\n")
                lines.append("</details>\n")

    return "\n".join(lines)


def generate_report(series_list):
    """Generate markdown report by collecting data then rendering."""
    data = generate_json(series_list)
    return json_to_markdown(data)


def generate_json(series_list):
    """Generate structured JSON report data."""
    from datetime import datetime, timezone

    results = {}
    for kver in series_list:
        print(f"  Fetching upstream versions for {kver}...", file=sys.stderr)
        upstream = get_upstream_versions(kver)
        if not upstream:
            results[kver] = {"versions": {}, "archs": ARCHS}
            continue

        archive_info = get_archive_info(kver)
        install_info = get_install_info(kver)

        all_versions = sorted(upstream.keys(), key=version_sort_key)
        versions_data = {}
        for v in all_versions:
            upstream_archs = upstream[v]
            arch_status = {}
            for arch in ARCHS:
                if arch not in upstream_archs:
                    arch_status[arch] = "unavailable"
                elif archive_info is not None and arch not in archive_info.get(v, {}):
                    arch_status[arch] = "missing_archive"
                elif install_info is not None and arch in install_info and v not in install_info[arch]:
                    arch_status[arch] = "missing_install"
                else:
                    arch_status[arch] = "ok"
            versions_data[v] = arch_status

        results[kver] = {
            "versions": versions_data,
            "archs": ARCHS,
            "has_archive": archive_info is not None,
            "has_install": install_info is not None,
        }

    return {
        "updated": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "series": results,
    }


def main():
    output_format = "markdown"
    from_json = False
    series_list = []

    args = sys.argv[1:]
    i = 0
    while i < len(args):
        if args[i] == "--json":
            # Legacy flag, equivalent to --format json
            output_format = "json"
        elif args[i] == "--format":
            i += 1
            if i >= len(args):
                print("ERROR: --format requires an argument (markdown or json)", file=sys.stderr)
                sys.exit(1)
            output_format = args[i]
            if output_format not in ("markdown", "json"):
                print(f"ERROR: --format must be 'markdown' or 'json', got '{output_format}'", file=sys.stderr)
                sys.exit(1)
        elif args[i] == "--from-json":
            from_json = True
        else:
            series_list.append(args[i])
        i += 1

    if from_json:
        # Read JSON from stdin and render as markdown
        data = json.load(sys.stdin)
        print(json_to_markdown(data))
    elif output_format == "json":
        if not series_list:
            series_list = get_active_series()
        data = generate_json(series_list)
        print(json.dumps(data, separators=(",", ":")))
    else:
        if not series_list:
            series_list = get_active_series()
        data = generate_json(series_list)
        print(json_to_markdown(data))


if __name__ == "__main__":
    main()
