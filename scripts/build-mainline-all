#!/usr/bin/env python3
"""Build mainline kernel headers images for all active kernel versions.

Queries https://www.kernel.org/releases.json for stable and longterm
versions that are not end-of-life, then builds each one via build-mainline.

Usage:
    ./scripts/build-mainline-all [--push] [--image PREFIX] [--platforms PLATFORMS]
"""

import argparse
import subprocess
import sys

_script_dir = __import__("os").path.dirname(__import__("os").path.abspath(__file__))
sys.path.insert(0, _script_dir)

from lib import IMAGE_PREFIX, fetch_active_kernel_versions


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Build mainline headers images for all active kernel versions.")
    parser.add_argument("--push", action="store_true",
                        help="Push to registry (default: load locally)")
    parser.add_argument("--force", action="store_true",
                        help="Force rebuild even if up-to-date")
    parser.add_argument("--scratch", action="store_true",
                        help="Cold start (ignore existing images)")
    parser.add_argument("--limit", type=int, default=None,
                        help="Max kernels to install per version")
    parser.add_argument("--image", default=IMAGE_PREFIX, dest="image_prefix",
                        help="Image prefix (default: %(default)s)")
    parser.add_argument("--platforms", default="",
                        help="Comma-separated platforms (auto-detected if omitted)")
    args = parser.parse_args()

    print("=== Fetching active kernel versions from kernel.org ===",
          file=sys.stderr)
    versions = fetch_active_kernel_versions()
    if not versions:
        print("ERROR: no active versions found", file=sys.stderr)
        sys.exit(1)

    print(f"Active versions: {' '.join(versions)}\n", file=sys.stderr)

    # Build each version by invoking scripts/build-mainline
    failed: list[str] = []
    for kver in versions:
        print(f"{'=' * 64}", file=sys.stderr)
        print(f"  Building {kver}", file=sys.stderr)
        print(f"{'=' * 64}", file=sys.stderr)

        cmd = [sys.executable, f"{_script_dir}/build-mainline", kver]
        if args.push:
            cmd.append("--push")
        if args.force:
            cmd.append("--force")
        if args.scratch:
            cmd.append("--scratch")
        if args.limit is not None:
            cmd += ["--limit", str(args.limit)]
        if args.image_prefix != IMAGE_PREFIX:
            cmd += ["--image", args.image_prefix]
        if args.platforms:
            cmd += ["--platforms", args.platforms]

        if subprocess.run(cmd).returncode != 0:
            print(f"ERROR: build failed for {kver}", file=sys.stderr)
            failed.append(kver)

    # Summary
    print(f"\n=== Summary ===", file=sys.stderr)
    print(f"Total: {len(versions)}", file=sys.stderr)
    if failed:
        print(f"Failed: {' '.join(failed)}", file=sys.stderr)
        sys.exit(1)
    else:
        print("All builds succeeded.", file=sys.stderr)


if __name__ == "__main__":
    main()
