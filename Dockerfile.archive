# syntax=docker/dockerfile:1
#
# Dockerfile.archive — archive mainline kernel header .debs.
# Architecture-independent: stores headers for ALL architectures.
#
# The fetching logic lives in scripts/build-archive, which downloads .debs
# into debs/<KVER>/ before invoking this Dockerfile.
#
# Build args:
#   KVER          - kernel series, e.g. "6.14" (required)
#   ARCHIVE_IMAGE - previous archive image for incremental builds
#                   (default: mainline-kernel-headers:<KVER>-archive)
#                   Set to "scratch" for cold start.
#

ARG KVER
ARG ARCHIVE_IMAGE=mainline-kernel-headers:${KVER}-archive

# ===========================================================================
# Stage 1: Generate kernel-versions.txt from .deb filenames
# ===========================================================================
FROM alpine:3.21 AS versions

ARG KVER
COPY debs/${KVER}/ /debs/

RUN <<'EOF'
set -eu
: > /kernel-versions.txt
for d in /debs/*/; do
    [ -d "$d" ] || continue
    v=$(basename "$d")
    # Normalize X.Y -> X.Y.0
    case "$v" in
        *.*.*) ;;
        *.*) v="${v}.0" ;;
    esac
    # Extract unique architectures from .deb filenames (excluding _all.deb)
    archs=$(find "$d" -maxdepth 1 -name '*.deb' ! -name '*_all.deb' \
        | sed -n 's/.*_\([^_]*\)\.deb$/\1/p' \
        | sort -u \
        | paste -sd,)
    [ -n "${archs}" ] && echo "${v}: ${archs}" >> /kernel-versions.txt
done
sort -V /kernel-versions.txt -o /kernel-versions.txt
cat /kernel-versions.txt
EOF

# ===========================================================================
# Stage 2: Accumulate .debs under /<KVER>/<version>/
# ===========================================================================
FROM ${ARCHIVE_IMAGE}

ARG KVER
COPY debs/${KVER}/ /${KVER}/
COPY --from=versions /kernel-versions.txt /kernel-versions.txt

CMD ["cat", "/kernel-versions.txt"]
